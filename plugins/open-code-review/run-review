#!/usr/bin/env python3
"""Open Code Review (ocr) Runner - Cloud Provider Engine"""

import glob
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time
from typing import Any

try:
    import readline
    _HAS_READLINE = True
except ImportError:
    _HAS_READLINE = False

try:
    from rich.console import Console
    from rich.markdown import Markdown
    from rich.panel import Panel
    _HAS_RICH = True
except ImportError:
    _HAS_RICH = False

ENV_FILE = os.path.expanduser("~/.config/py-agent/.env")
BG_DIRECTIVES = os.path.expanduser("~/.config/py-agent/plugins/open-code-review/codereview.md")
SPINNER_FRAMES = ("✦ [∿ · ·]", "✦ [· ∿ ·]", "✦ [· · ∿]", "✦ [· ∿ ·]")

RE_PLACEHOLDER = re.compile(
    r"^(x+|todo|changeme|replace.?me|<.*>|your_?\w*|<api-key>)$",
    re.IGNORECASE,
)
RE_RATE_LIMIT = re.compile(
    r"\b429\b|rate.?limit|rejected by provider",
    re.IGNORECASE,
)


def _init_path_completion() -> None:
    if not _HAS_READLINE:
        return

    def _complete_path(text: str, state: int) -> str | None:
        pattern = os.path.expanduser(text) + "*"
        matches = glob.glob(pattern)
        home = os.path.expanduser("~")
        formatted = []
        for m in sorted(matches):
            item = m + "/" if os.path.isdir(m) else m
            if text.startswith("~") and item.startswith(home):
                item = "~" + item[len(home):]
            formatted.append(item)
        try:
            return formatted[state]
        except IndexError:
            return None

    readline.set_completer_delims(" \t\n\"'")
    readline.parse_and_bind("tab: complete")
    readline.set_completer(_complete_path)


def _init_budget_completion() -> None:
    if not _HAS_READLINE:
        return

    options = ("off", "low", "medium", "high", "max")

    def _complete_budget(text: str, state: int) -> str | None:
        matches = [o for o in options if o.startswith(text.lower())]
        try:
            return matches[state]
        except IndexError:
            return None

    readline.set_completer_delims(" \t\n")
    readline.parse_and_bind("tab: complete")
    readline.set_completer(_complete_budget)


class TelemetrySpinner:
    def __init__(self, initial_msg: str = "Initializing review..."):
        self.message = initial_msg
        self.active = False
        self.thread = None
        self.start_time = 0.0
        self._lock = threading.Lock()

    def update(self, msg: str):
        with self._lock:
            self.message = msg

    def write_error(self, err_msg: str):
        """Thread-safe stderr output that clears the active spinner line first."""
        with self._lock:
            sys.stderr.write(f"\r\033[K\033[1;31m[error] {err_msg}\033[0m\n")
            sys.stderr.flush()

    def _spin(self):
        idx = 0
        while self.active:
            elapsed = time.time() - self.start_time
            if elapsed >= 60:
                m, s = divmod(int(elapsed), 60)
                elapsed_str = f"{m}m{s:02d}s"
            else:
                elapsed_str = f"{elapsed:.1f}s"

            with self._lock:
                msg = self.message

            try:
                term_cols = os.get_terminal_size().columns
            except OSError:
                term_cols = 80
            max_msg_len = max(20, term_cols - 35)
            if len(msg) > max_msg_len:
                msg = msg[:max_msg_len - 3] + "..."

            frame = SPINNER_FRAMES[idx % len(SPINNER_FRAMES)]
            with self._lock:
                sys.stderr.write(
                    f"\r\033[K\033[1;32m{frame}\033[0m \033[36m{msg}\033[0m \033[2m({elapsed_str})\033[0m"
                )
                sys.stderr.flush()
            idx += 1
            time.sleep(0.08)

    def start(self):
        self.active = True
        self.start_time = time.time()
        sys.stderr.write("\033[?25l")
        sys.stderr.flush()
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def stop(self, done_msg: str = "Analysis complete"):
        if not self.active:
            return
        self.active = False
        elapsed = time.time() - self.start_time
        if elapsed >= 60:
            m, s = divmod(int(elapsed), 60)
            elapsed_str = f"{m}m{s:02d}s"
        else:
            elapsed_str = f"{elapsed:.1f}s"

        if self.thread and self.thread.is_alive():
            self.thread.join(timeout=0.3)
        with self._lock:
            sys.stderr.write(f"\r\033[1;32m✓ {done_msg}\033[0m \033[2m({elapsed_str})\033[0m\n\n")
            sys.stderr.write("\033[?25h")
            sys.stderr.flush()


def load_env() -> tuple[dict[str, str], set[str]]:
    env = {}
    active_keys = set()
    if os.path.isfile(ENV_FILE):
        with open(ENV_FILE, "r", encoding="utf-8") as f:
            for line in f:
                s = line.strip()
                if not s or s.startswith("#") or "=" not in s:
                    continue
                k, v = s.split("=", 1)
                k = k.strip()
                val = v.strip().strip('"').strip("'")
                if val and not RE_PLACEHOLDER.search(val):
                    active_keys.add(k)
                env[k] = val
    return env, active_keys


def get_active_profile_title() -> str:
    """Reads the top heading from codereview.md to display in the review visual."""
    if os.path.isfile(BG_DIRECTIVES):
        try:
            with open(BG_DIRECTIVES, "r", encoding="utf-8") as f:
                for line in f:
                    s = line.strip()
                    if s.startswith("#"):
                        return s.lstrip("#").strip()
        except OSError:
            pass
    return "Default (Generic)"


def build_reasoning_payload(budget_val: str) -> tuple[dict[str, Any], str]:
    """Translates user-requested tiers or token counts into universal provider parameters."""
    val = str(budget_val).strip().lower() if budget_val else "medium"
    if val in ("def", "default", ""):
        val = "medium"

    if val.isdigit():
        tokens = int(val)
        if tokens <= 0:
            return {"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"
        effort = "low" if tokens <= 1200 else ("medium" if tokens <= 3000 else "high")
        return {
            "reasoning_effort": effort,
            "thinking": {"type": "enabled", "budget_tokens": tokens},
        }, f"{tokens} tokens"

    tiers = {
        "off": ({"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"),
        "none": ({"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"),
        "disabled": ({"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"),
        "minimal": ({"reasoning_effort": "minimal", "thinking": {"type": "enabled", "budget_tokens": 512}}, "minimal (~512t)"),
        "low": ({"reasoning_effort": "low", "thinking": {"type": "enabled", "budget_tokens": 1024}}, "low (~1kt)"),
        "medium": ({"reasoning_effort": "medium", "thinking": {"type": "enabled", "budget_tokens": 2500}}, "medium (~2.5kt)"),
        "high": ({"reasoning_effort": "high", "thinking": {"type": "enabled", "budget_tokens": 4096}}, "high (~4.1kt)"),
        "max": ({"reasoning_effort": "high", "thinking": {"type": "enabled", "budget_tokens": 8192}}, "max (~8.2kt)"),
    }
    return tiers.get(val, tiers["medium"])


def sync_ocr_config(env: dict[str, str], active_keys: set[str], reasoning_input: str) -> tuple[str, str, str, str, str, str]:
    extra_body, budget_desc = build_reasoning_payload(reasoning_input)

    if "CUSTOM_API_KEY" in active_keys:
        api_key = env.get("CUSTOM_API_KEY", "")
        model = env.get("CUSTOM_MODEL", "default")
        raw_url = env.get("CUSTOM_URL", "https://router.huggingface.co/v1")
        base_url = raw_url.replace("/chat/completions", "").rstrip("/")
        provider = "Custom 1"
        default_concurrency = "2"
    elif "CUSTOM2_API_KEY" in active_keys:
        api_key = env.get("CUSTOM2_API_KEY", "")
        model = env.get("CUSTOM2_MODEL", "default")
        raw_url = env.get("CUSTOM2_URL", "")
        base_url = raw_url.replace("/chat/completions", "").rstrip("/")
        provider = "Custom 2"
        default_concurrency = "2"
    elif "GEMINI_API_KEY" in active_keys:
        api_key = env.get("GEMINI_API_KEY", "")
        model = env.get("GEMINI_MODEL", "default")
        base_url = "https://generativelanguage.googleapis.com/v1beta/openai"
        provider = "Gemini"
        default_concurrency = "1"
    elif "OPENROUTER_API_KEY" in active_keys:
        api_key = env.get("OPENROUTER_API_KEY", "")
        model = env.get("OPENROUTER_MODEL", "default")
        base_url = "https://openrouter.ai/api/v1"
        provider = "OpenRouter"
        default_concurrency = "2"
    else:
        print("\033[1;31m[error] Open Code Review requires an active cloud API key.\033[0m")
        print("Set GEMINI_API_KEY, CUSTOM_API_KEY, or OPENROUTER_API_KEY in ~/.config/py-agent/.env")
        sys.exit(1)

    concurrency_raw = str(env.get("OCR_CONCURRENCY", default_concurrency) or "").strip()
    concurrency = concurrency_raw if re.fullmatch(r"[1-9]\d?", concurrency_raw) else default_concurrency

    # Clear active provider shadowing so llm.* settings take precedence
    subprocess.run(["ocr", "config", "unset", "provider"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.protocol", "openai"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.use_anthropic", "false"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.url", base_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.model", model], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.auth_token", api_key], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.extra_body", json.dumps(extra_body)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    return provider, model, concurrency, budget_desc, api_key, base_url


def parse_action(line: str) -> str | None:
    clean = re.sub(r"^\[ocr\]\s*", "", line).strip()
    if not clean:
        return None
    if "▶ code_search" in clean:
        m = re.search(r"search_text=([^\s]+)", clean)
        return f"Searching: {m.group(1)}" if m else "Searching symbols"
    if "▶ file_read" in clean:
        fp = re.search(r"file_path=([^\s]+)", clean)
        sl = re.search(r"start_line=(\d+)", clean)
        el = re.search(r"end_line=(\d+)", clean)
        fname = os.path.basename(fp.group(1)) if fp else "file"
        lines = f":{sl.group(1)}-{el.group(1)}" if (sl and el) else ""
        return f"Reading: {fname}{lines}"
    if "▶ code_comment" in clean:
        return "Synthesizing code comments"
    if "Summary:" in clean:
        return "Compiling summary report"
    if "plan request" in clean or "Plan phase" in clean:
        return "Formulating review plan"
    if "reviewing" in clean and "discovered" in clean:
        m = re.search(r"reviewing (\d+)", clean)
        return f"Auditing {m.group(1)} file(s)" if m else "Auditing codebase"
    return None


def main():
    rich_console = Console() if _HAS_RICH else None

    # Render header banner immediately on startup matching eval-stack layout
    if rich_console:
        rich_console.print(
            Panel(
                "[bold cyan]Open Code Review (OCR) — AI-Powered Code Review Engine[/bold cyan]\n"
                "[dim]Targeted cloud code review: Bug discovery, security checks, and line-level diagnostics[/dim]",
                border_style="cyan",
            )
        )

    if not shutil.which("ocr"):
        print("\033[1;31m[error] `ocr` executable not found in PATH. Install with: npm i -g @alibaba-group/open-code-review\033[0m")
        sys.exit(1)

    cur_dir = os.getcwd()
    target_input = sys.argv[1].strip() if len(sys.argv) > 1 else ""
    reasoning_arg = sys.argv[2].strip() if len(sys.argv) > 2 else ""

    env, active_keys = load_env()

    # 1. Prompt for Project Path (with filesystem tab completion)
    if not target_input:
        _init_path_completion()
        try:
            raw_target = input(f"Enter project path to review [default: {cur_dir}]: ")
            target_input = raw_target.strip().replace("\t", "")
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)

    target_path = os.path.abspath(os.path.expanduser(target_input or cur_dir))
    if not os.path.exists(target_path):
        print(f"\033[1;31m[error] Path does not exist:\033[0m {target_path}")
        sys.exit(1)

    # 2. Prompt for Reasoning Budget (with budget keyword tab completion)
    default_budget = env.get("OCR_BUDGET", env.get("OCR_EFFORT", "high"))
    if not reasoning_arg:
        _init_budget_completion()
        try:
            user_b = input(f"Reasoning budget [off/low/medium/high/max, or tokens like 2500] [default: {default_budget}]: ")
            cleaned_b = user_b.strip().replace("\t", "")
            reasoning_choice = cleaned_b or default_budget
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
    else:
        reasoning_choice = reasoning_arg.replace("\t", "")

    if _HAS_READLINE:
        readline.set_completer(None)

    is_file = os.path.isfile(target_path)
    target_dir = os.path.dirname(target_path) if is_file else target_path

    # Safe Git root resolution
    repo_root = None
    if shutil.which("git"):
        try:
            git_res = subprocess.run(
                ["git", "-C", target_dir, "rev-parse", "--show-toplevel"],
                capture_output=True,
                text=True,
            )
            if git_res.returncode == 0:
                repo_root = git_res.stdout.strip()
        except OSError:
            pass

    if repo_root:
        os.chdir(repo_root)
        rel_target = os.path.relpath(target_path, repo_root)
    else:
        os.chdir(target_dir)
        rel_target = os.path.basename(target_path) if is_file else "."

    provider, model, concurrency, budget_desc, api_key, base_url = sync_ocr_config(env, active_keys, reasoning_choice)

    home = os.path.expanduser("~")
    display_target = target_path.replace(home, "~", 1) if target_path.startswith(home) else target_path
    profile_title = get_active_profile_title()

    timeout_mins = str(env.get("OCR_TIMEOUT", "60")).strip()
    if not timeout_mins.isdigit() or int(timeout_mins) <= 0:
        timeout_mins = "60"

    print()
    if rich_console:
        rich_console.print(f"Review Target:   [bold yellow]{display_target}[/bold yellow]")
        rich_console.print(f"Active Profile:  [magenta]{profile_title}[/magenta]")
        rich_console.print(f"Review Engine:   [bold green]{provider}[/bold green] [dim]({model})[/dim]")
        rich_console.print(f"Review Config:   [cyan]{budget_desc}[/cyan] [dim]| Workers: {concurrency} | Timeout: {timeout_mins}m[/dim]\n")
    else:
        print(f"[review] Target:  {display_target}")
        print(f"[review] Profile: {profile_title}")
        print(f"[review] Engine:  {provider} ({model})")
        print(f"[review] Budget:  {budget_desc} | Workers: {concurrency} | Timeout: {timeout_mins}m\n")

    target_basename = os.path.basename(target_path)
    is_global_profile = any(k in profile_title.lower() for k in ("global", "policy", "generic", "default"))
    if not is_global_profile and target_basename not in profile_title:
        print("\033[33m  ↳ Notice: Active directives in codereview.md specify a different file target.\033[0m")

    timeout_flag = ["--timeout", timeout_mins]
    is_specific_target = is_file or (rel_target != ".")

    if is_specific_target:
        cmd = ["ocr", "scan", "--path", rel_target, "--concurrency", concurrency] + timeout_flag
    else:
        has_diff = False
        if repo_root and shutil.which("git"):
            try:
                has_diff = bool(subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True).stdout.strip())
            except OSError:
                pass
        if has_diff:
            bg_flag = ["--background-file", BG_DIRECTIVES] if os.path.isfile(BG_DIRECTIVES) else []
            cmd = ["ocr", "review", "--concurrency", concurrency] + bg_flag + timeout_flag
        else:
            cmd = ["ocr", "scan", "--concurrency", concurrency] + timeout_flag

    spinner = TelemetrySpinner(f"Starting review with {provider}...")
    spinner.start()

    report_lines: list[str] = []
    log_lines: list[str] = []
    proc = None

    child_env = {**os.environ}
    child_env["OCR_LLM_TOKEN"] = api_key or "not-needed"
    child_env["OCR_LLM_URL"] = base_url
    child_env["OCR_LLM_MODEL"] = model
    child_env["OCR_LLM_PROTOCOL"] = "openai"
    child_env["OCR_USE_ANTHROPIC"] = "false"
    child_env["OPENAI_API_KEY"] = api_key or "not-needed"
    child_env["OPENAI_BASE_URL"] = base_url

    try:
        proc = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            env=child_env,
        )

        for line in proc.stdout:
            raw = line.strip()
            if raw.startswith("[ocr]"):
                log_lines.append(line)
                action = parse_action(raw)
                if action:
                    spinner.update(action)
                if RE_RATE_LIMIT.search(raw):
                    spinner.update("Rate limited by provider, waiting for retry...")
            else:
                report_lines.append(line)

        proc.wait(timeout=int(timeout_mins) * 60 + 30)

    except subprocess.TimeoutExpired:
        if proc:
            proc.kill()
        spinner.stop("Timed out")
        print(f"\n\033[1;31m[error] Review exceeded {timeout_mins}m safety limit and was terminated.\033[0m")
        sys.exit(124)
    except KeyboardInterrupt:
        if proc:
            proc.kill()
        spinner.stop("Cancelled")
        print("\n\033[1;33m[review] Scan cancelled by user.\033[0m")
        sys.exit(130)
    finally:
        spinner.stop("Finished")
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()

    if proc and proc.returncode != 0:
        print(f"\033[1;31m[error] ocr finished with exit code {proc.returncode}:\033[0m")
        err_msg = "".join(report_lines).strip()
        if err_msg:
            print(err_msg)
        if log_lines:
            print("\033[2m--- ocr diagnostics ---\033[0m")
            print("".join(log_lines[-20:]).strip())
        sys.exit(proc.returncode)

    report_text = "".join(report_lines).strip()
    if report_text:
        if _HAS_RICH:
            Console().print(Markdown(report_text))
        else:
            print(report_text)
    else:
        print("\033[1;32m✓ No issues found.\033[0m")


if __name__ == "__main__":
    main()
