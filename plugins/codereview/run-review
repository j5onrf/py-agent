#!/usr/bin/env python3
"""Open Code Review (ocr) Runner - Universal Provider, Speed & Reasoning Engine"""

import json
import os
import re
import readline
import subprocess
import sys
import threading
import time

try:
    from rich.console import Console
    from rich.markdown import Markdown
    _HAS_RICH = True
except ImportError:
    _HAS_RICH = False

ENV_FILE = os.path.expanduser("~/.config/py-agent/.env")
BG_DIRECTIVES = os.path.expanduser("~/.config/py-agent/plugins/codereview/codereview.md")
SPINNER_FRAMES = ("✦ [∿ · ·]", "✦ [· ∿ ·]", "✦ [· · ∿]", "✦ [· ∿ ·]")


class TelemetrySpinner:
    def __init__(self, initial_msg: str = "Initializing review..."):
        self.message = initial_msg
        self.active = False
        self.thread = None
        self.start_time = 0.0
        self._lock = threading.Lock()

    def update(self, msg: str):
        with self._lock:
            self.message = msg

    def _spin(self):
        idx = 0
        while self.active:
            elapsed = time.time() - self.start_time
            if elapsed >= 60:
                m, s = divmod(int(elapsed), 60)
                elapsed_str = f"{m}m{s:02d}s"
            else:
                elapsed_str = f"{elapsed:.1f}s"

            frame = SPINNER_FRAMES[idx % len(SPINNER_FRAMES)]
            with self._lock:
                msg = self.message

            max_msg_len = max(20, os.get_terminal_size().columns - 35)
            if len(msg) > max_msg_len:
                msg = msg[:max_msg_len - 3] + "..."

            sys.stderr.write(
                f"\r\033[K\033[1;32m{frame}\033[0m \033[36m{msg}\033[0m \033[2m({elapsed_str})\033[0m"
            )
            sys.stderr.flush()
            idx += 1
            time.sleep(0.08)

    def start(self):
        self.active = True
        self.start_time = time.time()
        sys.stderr.write("\033[?25l")
        sys.stderr.flush()
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def stop(self, done_msg: str = "Analysis complete"):
        if not self.active:
            return
        self.active = False
        elapsed = time.time() - self.start_time
        if elapsed >= 60:
            m, s = divmod(int(elapsed), 60)
            elapsed_str = f"{m}m{s:02d}s"
        else:
            elapsed_str = f"{elapsed:.1f}s"

        if self.thread:
            self.thread.join(timeout=0.2)
        sys.stderr.write(f"\r\033[K\033[1;32m✔ {done_msg}\033[0m \033[2m({elapsed_str})\033[0m\n\n")
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()


def load_env() -> tuple[dict[str, str], set[str]]:
    env = {}
    active_keys = set()
    if os.path.isfile(ENV_FILE):
        with open(ENV_FILE, "r", encoding="utf-8") as f:
            for line in f:
                s = line.strip()
                if not s or "=" not in s:
                    continue
                is_commented = s.startswith("#")
                raw = s.lstrip("#").strip()
                if "=" in raw:
                    k, v = raw.split("=", 1)
                    k = k.strip()
                    val = v.strip().strip('"').strip("'")
                    if not is_commented and not any(sub in val.lower() for sub in ("your", "here", "api-key")):
                        active_keys.add(k)
                    if k not in env or not is_commented:
                        env[k] = val
    return env, active_keys


def build_reasoning_payload(budget_val: str) -> tuple[dict[str, Any], str]:
    """Translates user-requested tiers or token counts into universal provider parameters."""
    val = str(budget_val).strip().lower() if budget_val else "medium"
    if val in ("def", "default", ""):
        val = "medium"

    if val.isdigit():
        tokens = int(val)
        if tokens <= 0:
            return {"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"
        effort = "low" if tokens <= 1200 else ("medium" if tokens <= 3000 else "high")
        return {
            "reasoning_effort": effort,
            "thinking": {"type": "enabled", "budget_tokens": tokens},
        }, f"{tokens} tokens"

    tiers = {
        "off": ({"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"),
        "none": ({"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"),
        "disabled": ({"thinking": {"type": "disabled"}, "reasoning_effort": "low"}, "off"),
        "minimal": ({"reasoning_effort": "minimal", "thinking": {"type": "enabled", "budget_tokens": 512}}, "minimal (~512t)"),
        "low": ({"reasoning_effort": "low", "thinking": {"type": "enabled", "budget_tokens": 1024}}, "low (~1kt)"),
        "medium": ({"reasoning_effort": "medium", "thinking": {"type": "enabled", "budget_tokens": 2500}}, "medium (~2.5kt)"),
        "high": ({"reasoning_effort": "high", "thinking": {"type": "enabled", "budget_tokens": 4096}}, "high (~4.1kt)"),
        "max": ({"reasoning_effort": "high", "thinking": {"type": "enabled", "budget_tokens": 8192}}, "max (~8.2kt)"),
    }
    return tiers.get(val, tiers["medium"])


def sync_ocr_config(env: dict[str, str], active_keys: set[str], reasoning_input: str) -> tuple[str, str, str, str]:
    extra_body, budget_desc = build_reasoning_payload(reasoning_input)

    if "CUSTOM_API_KEY" in active_keys:
        api_key = env.get("CUSTOM_API_KEY", "")
        model = env.get("CUSTOM_MODEL", "default")
        raw_url = env.get("CUSTOM_URL", "https://router.huggingface.co/v1")
        base_url = raw_url.replace("/chat/completions", "").rstrip("/")
        provider = "Custom 1"
        default_concurrency = "2"
    elif "CUSTOM2_API_KEY" in active_keys:
        api_key = env.get("CUSTOM2_API_KEY", "")
        model = env.get("CUSTOM2_MODEL", "default")
        raw_url = env.get("CUSTOM2_URL", "")
        base_url = raw_url.replace("/chat/completions", "").rstrip("/")
        provider = "Custom 2"
        default_concurrency = "2"
    elif "GEMINI_API_KEY" in active_keys:
        api_key = env.get("GEMINI_API_KEY", "")
        model = env.get("GEMINI_MODEL", "default")
        base_url = "https://generativelanguage.googleapis.com/v1beta/openai"
        provider = "Gemini"
        default_concurrency = "1"
    elif "OPENROUTER_API_KEY" in active_keys:
        api_key = env.get("OPENROUTER_API_KEY", "")
        model = env.get("OPENROUTER_MODEL", "default")
        base_url = "https://openrouter.ai/api/v1"
        provider = "OpenRouter"
        default_concurrency = "2"
    else:
        api_key = "not-needed"
        model = "local-model"
        base_url = "http://127.0.0.1:8080/v1"
        provider = "Local (:8080)"
        default_concurrency = "1"

    concurrency = env.get("OCR_CONCURRENCY", default_concurrency)

    subprocess.run(["ocr", "config", "set", "llm.use_anthropic", "false"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.url", base_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.auth_token", api_key], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.model", model], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.extra_body", json.dumps(extra_body)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    return provider, model, concurrency, budget_desc


def parse_action(line: str) -> str | None:
    clean = re.sub(r"^\[ocr\]\s*", "", line).strip()
    if not clean:
        return None
    if "▶ code_search" in clean:
        m = re.search(r"search_text=([^\s]+)", clean)
        return f"Searching: {m.group(1)}" if m else "Searching symbols"
    if "▶ file_read" in clean:
        fp = re.search(r"file_path=([^\s]+)", clean)
        sl = re.search(r"start_line=(\d+)", clean)
        el = re.search(r"end_line=(\d+)", clean)
        fname = os.path.basename(fp.group(1)) if fp else "file"
        lines = f":{sl.group(1)}-{el.group(1)}" if (sl and el) else ""
        return f"Reading: {fname}{lines}"
    if "▶ code_comment" in clean:
        return "Synthesizing code comments"
    if "Summary:" in clean:
        return "Compiling summary report"
    if "plan request" in clean or "Plan phase" in clean:
        return "Formulating review plan"
    if "reviewing" in clean and "discovered" in clean:
        m = re.search(r"reviewing (\d+)", clean)
        return f"Auditing {m.group(1)} file(s)" if m else "Auditing codebase"
    return None


def main():
    cur_dir = os.getcwd()
    target_input = sys.argv[1].strip() if len(sys.argv) > 1 else ""
    reasoning_arg = sys.argv[2].strip() if len(sys.argv) > 2 else ""

    env, active_keys = load_env()

    # 1. Prompt for Project Path
    if not target_input:
        try:
            target_input = input(f"Enter project path to review [default: {cur_dir}]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)

    target_path = os.path.abspath(os.path.expanduser(target_input or cur_dir))
    if not os.path.exists(target_path):
        print(f"\033[1;31m[error] Path does not exist:\033[0m {target_path}")
        sys.exit(1)

    # 2. Prompt for Reasoning Budget
    default_budget = env.get("OCR_BUDGET", env.get("OCR_EFFORT", "medium"))
    if not reasoning_arg:
        try:
            user_b = input(f"Reasoning budget [off/low/medium/high/max, or tokens like 2500] [default: {default_budget}]: ").strip()
            reasoning_choice = user_b or default_budget
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)
    else:
        reasoning_choice = reasoning_arg

    is_file = os.path.isfile(target_path)
    target_dir = os.path.dirname(target_path) if is_file else target_path

    # Resolve Git root to compute relative paths accurately
    git_res = subprocess.run(
        ["git", "-C", target_dir, "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
    )

    if git_res.returncode == 0:
        repo_root = git_res.stdout.strip()
        os.chdir(repo_root)
        rel_target = os.path.relpath(target_path, repo_root)
    else:
        repo_root = None
        os.chdir(target_dir)
        rel_target = os.path.basename(target_path) if is_file else "."

    provider, model, concurrency, budget_desc = sync_ocr_config(env, active_keys, reasoning_choice)

    home = os.path.expanduser("~")
    display_target = target_path.replace(home, "~", 1) if target_path.startswith(home) else target_path

    # Scale timeout based on requested reasoning depth (up to 60m for max)
    choice_low = reasoning_choice.lower()
    if choice_low in ("max", "8192") or (choice_low.isdigit() and int(choice_low) >= 6000):
        timeout_mins = "60"
    elif choice_low in ("high", "4096") or (choice_low.isdigit() and int(choice_low) >= 3500):
        timeout_mins = "30"
    elif choice_low in ("medium", "2500", "def", "default") or (choice_low.isdigit() and int(choice_low) >= 1500):
        timeout_mins = "25"
    else:
        timeout_mins = "15"

    print(f"\n\033[1;36m[review]\033[0m Target: \033[1;33m{display_target}\033[0m")
    print(f"\033[1;36m[review]\033[0m Engine: \033[1;32m{provider}\033[0m \033[2m({model})\033[0m")
    print(f"\033[1;36m[review]\033[0m Budget: \033[1;34m{budget_desc}\033[0m | Workers: \033[1;35m{concurrency}\033[0m | Timeout: \033[1;33m{timeout_mins}m\033[0m")

    timeout_flag = ["--timeout", timeout_mins]

    if is_file:
        cmd = ["ocr", "scan", "--path", rel_target, "--concurrency", concurrency] + timeout_flag
    else:
        is_git = repo_root is not None
        has_diff = is_git and bool(subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True).stdout.strip())

        bg_flag = ["--background-file", BG_DIRECTIVES] if (has_diff and os.path.isfile(BG_DIRECTIVES)) else []
        if has_diff:
            cmd = ["ocr", "review", "--concurrency", concurrency] + bg_flag + timeout_flag
        else:
            path_arg = ["--path", rel_target] if rel_target != "." else []
            cmd = ["ocr", "scan", "--concurrency", concurrency] + path_arg + timeout_flag

    spinner = TelemetrySpinner(f"Starting review with {provider}...")
    spinner.start()

    report_lines = []
    proc = None

    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )

        for line in proc.stdout:
            raw = line.strip()
            if raw.startswith("[ocr]"):
                action = parse_action(raw)
                if action:
                    spinner.update(action)
                if "429" in raw or "rate limited" in raw.lower() or "rejected by provider" in raw.lower():
                    sys.stderr.write(f"\r\033[K\033[1;31m[error] {raw}\033[0m\n")
                    sys.stderr.flush()
            else:
                report_lines.append(line)

        proc.wait()
    except KeyboardInterrupt:
        if proc:
            proc.kill()
        spinner.stop("Cancelled")
        print("\n\033[1;33m[review] Scan cancelled.\033[0m")
        sys.exit(130)
    finally:
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()

    if proc and proc.returncode != 0:
        spinner.stop("Failed")
        print(f"\033[1;31m[error] ocr finished with exit code {proc.returncode}:\033[0m")
        err_msg = "".join(report_lines).strip()
        if err_msg:
            print(err_msg)
        sys.exit(proc.returncode)

    spinner.stop("Review complete")

    report_text = "".join(report_lines).strip()
    if report_text:
        if _HAS_RICH:
            Console().print(Markdown(report_text))
        else:
            print(report_text)
    else:
        print("\033[1;32m✔ No issues found.\033[0m")


if __name__ == "__main__":
    main()
