#!/usr/bin/env python3
"""Open Code Review (ocr) Runner with Live Output and Rate-Limit Protection"""

import os
import readline
import subprocess
import sys

ENV_FILE = os.path.expanduser("~/.config/py-agent/.env")


def load_env() -> dict[str, str]:
    env = {}
    if os.path.isfile(ENV_FILE):
        with open(ENV_FILE, "r", encoding="utf-8") as f:
            for line in f:
                s = line.strip()
                if s and not s.startswith("#") and "=" in s:
                    k, v = s.split("=", 1)
                    env[k.strip()] = v.strip().strip('"').strip("'")
    return env


def sync_ocr_config(env: dict[str, str]) -> tuple[str, str]:
    if "OPENROUTER_API_KEY" in env:
        api_key = env["OPENROUTER_API_KEY"]
        model = env.get("OPENROUTER_MODEL", "openrouter/free")
        base_url = "https://openrouter.ai/api/v1"
        provider = "OpenRouter"
    elif "CUSTOM2_API_KEY" in env:
        api_key = env["CUSTOM2_API_KEY"]
        model = env.get("CUSTOM2_MODEL", "deepseek-v4.1:free")
        raw_url = env.get("CUSTOM2_URL", "https://tokenharbor.ai/v1")
        base_url = raw_url.replace("/chat/completions", "").rstrip("/")
        provider = "TokenHarbor / Custom 2"
    elif "GEMINI_API_KEY" in env:
        api_key = env["GEMINI_API_KEY"]
        model = env.get("GEMINI_MODEL", "gemini-3.8-flash")
        base_url = "https://generativelanguage.googleapis.com/v1beta/openai"
        provider = "Gemini"
    else:
        api_key = "not-needed"
        model = "local-model"
        base_url = "http://127.0.0.1:8080/v1"
        provider = "Local (:8080)"

    subprocess.run(["ocr", "config", "set", "llm.use_anthropic", "false"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.url", base_url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.auth_token", api_key], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    subprocess.run(["ocr", "config", "set", "llm.model", model], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)

    return provider, model


def main():
    cur_dir = os.getcwd()
    target_input = sys.argv[1].strip() if len(sys.argv) > 1 else ""

    if not target_input:
        try:
            target_input = input(f"Enter project path to review [default: {cur_dir}]: ").strip()
        except (KeyboardInterrupt, EOFError):
            print("\nCancelled.")
            sys.exit(0)

    target_path = os.path.abspath(os.path.expanduser(target_input or cur_dir))
    if not os.path.exists(target_path):
        print(f"\033[1;31m[error] Path does not exist:\033[0m {target_path}")
        sys.exit(1)

    env = load_env()
    provider, model = sync_ocr_config(env)

    home = os.path.expanduser("~")
    display_target = target_path.replace(home, "~", 1) if target_path.startswith(home) else target_path

    print(f"\033[1;36m[review]\033[0m Target: \033[1;33m{display_target}\033[0m")
    print(f"\033[1;36m[review]\033[0m Engine: \033[1;32m{provider}\033[0m \033[2m({model})\033[0m\n")

    os.chdir(target_path)

    is_git = subprocess.run(["git", "rev-parse", "--is-inside-work-tree"], capture_output=True, text=True).returncode == 0
    has_diff = is_git and bool(subprocess.run(["git", "status", "--porcelain"], capture_output=True, text=True).stdout.strip())
    cmd = ["ocr", "review", "--concurrency", "2"] if has_diff else ["ocr", "scan", "--concurrency", "2"]

    # Stream output directly to terminal so progress and errors appear in real time
    try:
        proc = subprocess.run(cmd)
        sys.exit(proc.returncode)
    except KeyboardInterrupt:
        print("\n\033[1;33m[review] Scan cancelled.\033[0m")
        sys.exit(130)


if __name__ == "__main__":
    main()
