def validate_code_ast(code: str) -> tuple[bool, str]:
    """Pre-flight AST validation: checks syntax and blocks dynamic execution and system escapes."""
    try:
        tree = ast.parse(code)
    except SyntaxError as e:
        return False, f"SyntaxError: {e.msg} (line {e.lineno})"

    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for alias in node.names:
                mod = alias.name.split(".")[0]
                if mod in FORBIDDEN_MODULES:
                    return False, f"Security: module '{mod}' forbidden in eval"
        elif isinstance(node, ast.ImportFrom):
            mod = (node.module or "").split(".")[0]
            if mod in FORBIDDEN_MODULES:
                return False, f"Security: module '{mod}' forbidden in eval"
        elif isinstance(node, ast.Call):
            fn = node.func
            fname = fn.id if isinstance(fn, ast.Name) else (fn.attr if isinstance(fn, ast.Attribute) else "")
            if fname in FORBIDDEN_CALLS:
                return False, f"Security: call '{fname}()' forbidden in eval"
        elif isinstance(node, ast.Attribute):
            if node.attr.startswith("__") and node.attr.endswith("__"):
                if node.attr in ("__subclasses__", "__bases__", "__class__", "__globals__", "__code__"):
                    return False, f"Security: dunder '{node.attr}' forbidden in eval"

    return True, ""


def extract_python_code(raw_response: str) -> str:
    """Extracts raw python code from markdown or plain text, trimming trailing prose accurately."""
    clean = re.sub(r"<think(?:ing)?>[\s\S]*?(?:</think(?:ing)?>|$)", "", raw_response, flags=re.IGNORECASE).strip()
    clean = re.sub(r"<thought>[\s\S]*?(?:</thought>|$)", "", clean, flags=re.IGNORECASE).strip()

    # Prioritize explicit python code fences
    fences = re.findall(r"```(?:python|py)\s*\n?([\s\S]*?)```", clean, re.IGNORECASE)
    if not fences:
        fences = re.findall(r"```\s*\n?([\s\S]*?)```", clean)

    if fences:
        for block in fences:
            if "def " in block:
                return block.strip()
        return fences[0].strip()

    # If no fences, extract starting from the first def/import/class and iteratively trim trailing prose
    lines = clean.splitlines()
    for i, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith(("def ", "import ", "from ", "class ")):
            candidate = "\n".join(lines[i:]).strip()
            ok, _ = validate_code_ast(candidate)
            if not ok:
                for end in range(len(lines), i, -1):
                    cand_shrunk = "\n".join(lines[i:end]).strip()
                    if validate_code_ast(cand_shrunk)[0]:
                        return cand_shrunk
            return candidate

    return clean


def run_single_test(bench: dict, thinking_budget: int = 0) -> tuple[bool, float, int, str]:
    """Runs a single HumanEval task and verifies with deterministic assertions."""
    messages = [
        {
            "role": "system",
            "content": (
                "You are an expert Python programming assistant. "
                "Write clean, correct, self-contained Python code. "
                "Output ONLY the python code block with no conversational text or explanations."
            ),
        },
        {"role": "user", "content": bench["prompt"]},
    ]

    t0 = time.time()
    sink = io.StringIO()
    with contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
        response = core.stream_response(messages, prefix="AI:", show_stats=False, thinking_budget=thinking_budget)
    elapsed = time.time() - t0

    if not response:
        sink_err = sink.getvalue().strip()
        return False, elapsed, 0, (sink_err.splitlines()[-1] if sink_err else "Empty response")

    code = extract_python_code(response)
    toks = core.get_accurate_token_count(response)

    ast_ok, ast_err = validate_code_ast(code)
    if not ast_ok:
        return False, elapsed, toks, ast_err

    test_harness = f"{code}\n\n{bench['test_code']}"

    sandbox_dir = tempfile.mkdtemp(prefix="he_eval_")
    test_file = os.path.join(sandbox_dir, "test_eval.py")

    safe_env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "HOME": sandbox_dir,
        "PYTHONPATH": sandbox_dir,
    }

    try:
        with open(test_file, "w", encoding="utf-8") as f:
            f.write(test_harness)

        # Process group detachment with group-signaled termination on timeout
        p = subprocess.Popen(
            [sys.executable, test_file],
            cwd=sandbox_dir,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            stdin=subprocess.DEVNULL,
            env=safe_env,
            start_new_session=True,
        )

        try:
            stdout, stderr = p.communicate(timeout=5)
            passed = (p.returncode == 0)
            err_msg = ""
            if not passed:
                err_lines = [l.strip() for l in stderr.strip().splitlines() if l.strip()]
                err_msg = err_lines[-1] if err_lines else f"Exit code {p.returncode}"
            return passed, elapsed, toks, err_msg
        except subprocess.TimeoutExpired:
            with contextlib.suppress(Exception):
                os.killpg(os.getpgid(p.pid), signal.SIGKILL)
            p.communicate()
            return False, elapsed, toks, "Execution Timed Out (>5s)"
    except Exception as e:
        return False, elapsed, toks, str(e)
    finally:
        shutil.rmtree(sandbox_dir, ignore_errors=True)


def get_current_model_info() -> tuple[str, str]:
    """Inspects active cloud cascade or local endpoint configuration gracefully."""
    try:
        configs = cloud.get_active_configs([])
        if configs and isinstance(configs[0], (tuple, list)) and len(configs[0]) >= 3:
            url = configs[0][0]
            body_cfg = configs[0][2]
            model = body_cfg.get("model", "cloud-model") if isinstance(body_cfg, dict) else "cloud-model"
            return str(model), str(url)
    except Exception as e:
        if os.environ.get("AI_DEBUG") == "1":
            sys.stderr.write(f"[debug] cloud config check error: {e}\n")

    try:
        local_name = ui.get_local_model_name()
        return str(local_name), "http://127.0.0.1:8080"
    except Exception:
        return "local-model", "http://127.0.0.1:8080"


def main():
    filter_arg = None
    thinking_budget = 0

    args = sys.argv[1:]
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-t", "--thinking", "--budget"):
            if i + 1 < len(args):
                try:
                    thinking_budget = max(0, int(args[i + 1]))
                except ValueError:
                    sys.stderr.write(f"[warning] Ignoring non-integer thinking budget '{args[i + 1]}'\n")
                i += 2
            else:
                sys.stderr.write("[warning] Flag '-t/--budget' requires an integer argument.\n")
                i += 1
        elif not arg.startswith("-") and filter_arg is None:
            filter_arg = arg.strip().lower()
            i += 1
        else:
            i += 1

    console.print(
        Panel(
            "[bold cyan]Py-Agent HumanEval & Code Quality Benchmark Suite[/bold cyan]\n"
            "[dim]Deterministic assertion verification & tokens/sec speed testing[/dim]",
            border_style="cyan",
        )
    )

    model_name, endpoint = get_current_model_info()

    console.print(f"• [bold green]Active Target Model[/bold green]: [bold]{model_name}[/bold]")
    console.print(f"• [dim]Target Endpoint[/dim]: {endpoint}")
    if thinking_budget > 0:
        console.print(f"• [dim]Reasoning Budget[/dim]: {thinking_budget} tokens")
    console.print()

    active_benchmarks = BENCHMARKS
    if filter_arg:
        active_benchmarks = [
            b for b in BENCHMARKS
            if filter_arg in b["id"].lower() or filter_arg in b["name"].lower() or filter_arg in b["category"].lower()
        ]
        if not active_benchmarks:
            console.print(f"[red]Error: No benchmarks matched filter '{filter_arg}'.[/red]")
            sys.exit(1)

    results = []
    passed_count = 0
    total_tokens = 0
    total_time = 0.0

    try:
        for idx, bench in enumerate(active_benchmarks, start=1):
            console.print(
                f"\r\x1b[2K[dim][{idx}/{len(active_benchmarks)}][/dim] Evaluating [cyan]{bench['id']}[/cyan] ({bench['name']})...",
                end="\r",
            )
            passed, elapsed, toks, err = run_single_test(bench, thinking_budget=thinking_budget)

            total_tokens += toks
            total_time += elapsed

            if passed:
                passed_count += 1
                status_str = "[bold green]PASS[/bold green]"
                detail = f"{elapsed:.2f}s ({toks}t)"
            else:
                status_str = "[bold red]FAIL[/bold red]"
                detail = f"[dim red]{err[:32]}[/dim red]"

            tps = (toks / elapsed) if elapsed > 0 else 0
            results.append((
                bench["id"],
                bench["name"],
                bench["category"],
                status_str,
                detail,
                f"{tps:.1f} t/s",
            ))

            console.print(
                f"\r\x1b[2K  {'✔' if passed else '✖'} {status_str} : "
                f"[bold]{bench['id']}[/bold] {bench['name']:<25} {detail:<22} @ [cyan]{tps:.1f} t/s[/cyan]"
            )
    except KeyboardInterrupt:
        console.print("\n\n[yellow]Benchmark cancelled by user.[/yellow]")
        sys.exit(130)

    accuracy = (passed_count / len(active_benchmarks)) * 100 if active_benchmarks else 0
    avg_tps = (total_tokens / total_time) if total_time > 0 else 0

    table = Table(title=f"\nBenchmark Results: {model_name}", border_style="bright_black")
    table.add_column("ID", style="cyan", justify="left")
    table.add_column("Problem", style="white")
    table.add_column("Domain", style="dim")
    table.add_column("Result", justify="center")
    table.add_column("Details", style="dim")
    table.add_column("Speed", style="green", justify="right")

    for row in results:
        table.add_row(*row)

    console.print(table)

    score_color = "green" if accuracy >= 80 else "yellow" if accuracy >= 50 else "red"
    console.print(
        f"\n[bold]Final Scorecard:[/bold] [{score_color}]{passed_count}/{len(active_benchmarks)} Passed ({accuracy:.1f}%)[/{score_color}] "
        f"| Avg Speed: [bold cyan]{avg_tps:.1f} t/s[/bold cyan] | Total Time: [dim]{total_time:.2f}s[/dim]\n"
    )


if __name__ == "__main__":
    main()
