def list_available_profiles() -> list[tuple[str, str]]:
    skills_dir = os.path.join(CFG_DIR, "skills")
    profiles_dir = os.path.join(skills_dir, "profiles")
    found = []

    if os.path.isdir(profiles_dir):
        for root, _, files in os.walk(profiles_dir):
            for f in sorted(files):
                if f.endswith(".md"):
                    full = os.path.join(root, f)
                    rel = os.path.relpath(full, profiles_dir)
                    prof_key = os.path.splitext(rel)[0]
                    lbl = (
                        f"Custom {os.path.basename(prof_key).title()}"
                        if prof_key.startswith("custom/")
                        else prof_key.replace("/pro", " Pro").title()
                    )
                    found.append((prof_key, lbl))
    return found


def select_profile_interactive(profiles: list[tuple[str, str]], default_key: str = "lingtiny") -> str:
    current_idx = next(
        (i for i, (k, _) in enumerate(profiles) if k == default_key or os.path.basename(k) == os.path.basename(default_key)),
        0,
    )
    num_opts = len(profiles)
    last_lines = 0

    try:
        tty_in = open("/dev/tty", "r")
        tty_fd = tty_in.fileno()
    except Exception:
        tty_in = None
        tty_fd = sys.stdin.fileno() if sys.stdin.isatty() else None

    def _get_k() -> str | None:
        if tty_fd is not None:
            try:
                old = termios.tcgetattr(tty_fd)
                try:
                    tty.setraw(tty_fd)
                    termios.tcflush(tty_fd, termios.TCIFLUSH)
                    b = os.read(tty_fd, 1)
                    if not b:
                        return None
                    if b == b"\x1b" and select.select([tty_fd], [], [], 0.05)[0]:
                        b += os.read(tty_fd, 2)
                    return b.decode("utf-8", errors="ignore")
                finally:
                    termios.tcsetattr(tty_fd, termios.TCSADRAIN, old)
            except Exception:
                return None
        return None

    try:
        sys.stderr.write("\033[?25l")
        while True:
            if last_lines > 0:
                sys.stderr.write(f"\033[{last_lines}A\r\033[J")

            lines_count = 2
            sys.stderr.write(
                "\n\033[1;36mSelect Profile to Benchmark:\033[0m \033[2m(Up/Down navigate, 1-9 select, Enter run, Esc default, q abort)\033[0m\n"
            )

            for idx, (k, lbl) in enumerate(profiles):
                marker = " *" if k in (default_key, "custom/lingtiny", "custom/nexn25") else ""
                prefix = (
                    f"\033[1;33m  > {idx+1:2d}. {lbl:<22}\033[0m \033[90m({k})\033[0m{marker}\n"
                    if idx == current_idx
                    else f"\033[37m    {idx+1:2d}. {lbl:<22}\033[0m \033[2m({k})\033[0m{marker}\n"
                )
                sys.stderr.write(prefix)
                lines_count += 1

            sys.stderr.write(f"\n\033[2m:: Enter run [{profiles[current_idx][1]}]  Esc: default  q: abort\033[0m\n")
            lines_count += 2
            sys.stderr.flush()

            last_lines = lines_count
            key = _get_k()

            if key is None:
                current_idx = next((i for i, (k, _) in enumerate(profiles) if k == default_key), 0)
                break
            if key in ("\x1b[A", "k", "K"):
                current_idx = (current_idx - 1 + num_opts) % num_opts
            elif key in ("\x1b[B", "j", "J"):
                current_idx = (current_idx + 1) % num_opts
            elif key.isdigit() and 1 <= int(key) <= num_opts:
                current_idx = int(key) - 1
                break
            elif key in ("\r", "\n"):
                break
            elif key == "\x03":
                sys.stderr.write(f"\033[{last_lines}A\r\033[J\nBenchmark cancelled by user.\n")
                sys.exit(130)
            elif key in ("q", "Q"):
                sys.stderr.write(f"\033[{last_lines}A\r\033[J\nBenchmark aborted.\n")
                sys.exit(0)
            elif key == "\x1b":
                current_idx = next((i for i, (k, _) in enumerate(profiles) if k == default_key), 0)
                break

        sys.stderr.write(f"\033[{last_lines}A\r\033[J")
        sys.stderr.flush()
        return profiles[current_idx][0]
    finally:
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()
        if tty_in:
            try:
                tty_in.close()
            except Exception:
                pass


def resolve_dynamic_profile(cli_profile_arg: str | None = None) -> tuple[str, str]:
    skills_dir = os.path.join(CFG_DIR, "skills")
    if cli_profile_arg and not cli_profile_arg.startswith("-"):
        clean_arg = cli_profile_arg.lstrip("-")
        if content := skills.load_skill_content(clean_arg, skills_dir, CFG_DIR):
            return clean_arg, content
        if not clean_arg.startswith("custom/") and (
            content := skills.load_skill_content(f"custom/{clean_arg}", skills_dir, CFG_DIR)
        ):
            return f"custom/{clean_arg}", content

    profiles = list_available_profiles()
    if profiles and not os.environ.get("AI_CONTEXT_RUN"):
        model_name, _ = get_current_model_info()
        m_lower = model_name.lower()
        def_key = "lingtiny"
        for k, _ in profiles:
            base_k = os.path.basename(k).lower()
            if ("ling" in m_lower and "ling" in base_k) or \
               ("kat" in m_lower and "kat" in base_k) or \
               ("nex" in m_lower and "nex" in base_k) or \
               ("qwen" in m_lower and ("qwen" in base_k or "q2b" in base_k)) or \
               ("lfm" in m_lower and "lfm" in base_k) or \
               ("cpm" in m_lower and "cpm" in base_k):
                def_key = k
                break

        chosen_key = select_profile_interactive(profiles, def_key)
        if content := skills.load_skill_content(chosen_key, skills_dir, CFG_DIR):
            return chosen_key, content


