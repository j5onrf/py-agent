def list_available_profiles() -> list[tuple[str, str]]:
    """Discovers all available agent profiles in skills/profiles/."""
    skills_dir = os.path.join(CFG_DIR, "skills")
    profiles_dir = os.path.join(skills_dir, "profiles")
    found = []
    
    if os.path.isdir(profiles_dir):
        for root, _, files in os.walk(profiles_dir):
            for f in sorted(files):
                if f.endswith(".md"):
                    full = os.path.join(root, f)
                    rel = os.path.relpath(full, profiles_dir)
                    prof_key = os.path.splitext(rel)[0]
                    if prof_key.startswith("custom/"):
                        lbl = f"Custom {os.path.basename(prof_key).title()}"
                    else:
                        lbl = prof_key.replace("/pro", " Pro").title()
                    found.append((prof_key, lbl))
    return found


def select_profile_interactive(profiles: list[tuple[str, str]], default_key: str = "custom/base") -> str:
    """Raw terminal arrow-key, vi-key, and number selector for profiles."""
    current_idx = 0
    for i, (k, _) in enumerate(profiles):
        if k == default_key or k in ("custom/minicpm", "custom/pysmol"):
            current_idx = i
            break

    num_opts = len(profiles)
    last_lines = 0

    try:
        tty_in = open("/dev/tty", "r")
        tty_fd = tty_in.fileno()
    except Exception:
        tty_in = None
        tty_fd = sys.stdin.fileno() if sys.stdin.isatty() else None

    def _get_k():
        if tty_fd is not None:
            try:
                old = termios.tcgetattr(tty_fd)
                try:
                    tty.setraw(tty_fd)
                    termios.tcflush(tty_fd, termios.TCIFLUSH)
                    b = os.read(tty_fd, 1)
                    if b == b"\x1b" and select.select([tty_fd], [], [], 0.05)[0]:
                        b += os.read(tty_fd, 2)
                    return b.decode("utf-8", errors="ignore")
                finally:
                    termios.tcsetattr(tty_fd, termios.TCSADRAIN, old)
            except Exception:
                pass
        return ""

    try:
        sys.stderr.write("\033[?25l")
        while True:
            if last_lines > 0:
                sys.stderr.write(f"\033[{last_lines}A\r\033[J")

            lines_count = 0
            sys.stderr.write("\n\033[1;36mSelect Profile to Benchmark:\033[0m \033[2m(↑/↓ navigate, 1-9 select, ↵ run, Esc default)\033[0m\n")
            lines_count += 2

            for idx, (k, lbl) in enumerate(profiles):
                marker = " \033[1;32m★\033[0m" if k in (default_key, "custom/minicpm") else ""
                if idx == current_idx:
                    sys.stderr.write(f"\033[1;33m  ❯ {idx+1:2d}. {lbl:<22}\033[0m \033[90m({k})\033[0m{marker}\n")
                else:
                    sys.stderr.write(f"\033[37m    {idx+1:2d}. {lbl:<22}\033[0m \033[2m({k})\033[0m{marker}\n")
                lines_count += 1

            sys.stderr.write(f"\n\033[2m:: ↵ run [{profiles[current_idx][1]}]  Esc: default\033[0m\n")
            lines_count += 2
            sys.stderr.flush()

            last_lines = lines_count
            key = _get_k()

            if key in ("\x1b[A", "k", "K"):
                current_idx = (current_idx - 1 + num_opts) % num_opts
            elif key in ("\x1b[B", "j", "J"):
                current_idx = (current_idx + 1) % num_opts
            elif key.isdigit() and 1 <= int(key) <= num_opts:
                current_idx = int(key) - 1
                break
            elif key in ("\r", "\n", ""):
                break
            elif key in ("\x03", "\x1b", "q", "Q"):
                for i, (k, _) in enumerate(profiles):
                    if k == default_key:
                        current_idx = i
                        break
                break

        sys.stderr.write(f"\033[{last_lines}A\r\033[J")
        sys.stderr.flush()
        return profiles[current_idx][0]
    finally:
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()
        if tty_in:
            try:
                tty_in.close()
            except Exception:
                pass


def resolve_dynamic_profile(cli_profile_arg: str | None = None) -> tuple[str, str]:
    """Dynamically detects active profile, opens interactive menu, or accepts CLI override."""
    skills_dir = os.path.join(CFG_DIR, "skills")
    
    # 1. Direct CLI argument (e.g. eval-stack pysmol, eval-stack minicpm)
    if cli_profile_arg and not cli_profile_arg.startswith("-"):
        clean_arg = cli_profile_arg.lstrip("-")
        content = skills.load_skill_content(clean_arg, skills_dir, CFG_DIR)
        if content:
            return clean_arg, content
        if not clean_arg.startswith("custom/"):
            content = skills.load_skill_content(f"custom/{clean_arg}", skills_dir, CFG_DIR)
            if content:
                return f"custom/{clean_arg}", content

    # 2. Check active environment or workspace config
    active_env = os.environ.get("AI_ACTIVE_SKILL")
    if active_env:
        first_skill = active_env.split()[0]
        content = skills.load_skill_content(first_skill, skills_dir, CFG_DIR)
        if content:
            return first_skill, content

    ws_path = os.environ.get("AI_WORKSPACE_PATH", os.getcwd())
    cfg_file = os.path.join(ws_path, ".agent", "config.json")
    if os.path.isfile(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as cf:
                saved_prof = json.load(cf).get("profile", "")
                if saved_prof:
                    content = skills.load_skill_content(saved_prof, skills_dir, CFG_DIR)
                    if content:
                        return saved_prof, content
        except Exception:
            pass

    # 3. Interactive Arrow-Key Menu (if in terminal without args)
    if not os.environ.get("AI_CONTEXT_RUN"):
        profiles = list_available_profiles()
        if profiles:
            chosen_key = select_profile_interactive(profiles, "custom/base")
            content = skills.load_skill_content(chosen_key, skills_dir, CFG_DIR)
            if content:
                return chosen_key, content

    # Universal Default
    default_prof = "custom/base"
    content = skills.load_skill_content(default_prof, skills_dir, CFG_DIR) or "You are an autonomous AI software engineer."
    return default_prof, content


def get_current_model_info() -> tuple[str, str]:
    configs = cloud.get_active_configs([])
    if configs:
        url = configs[0][0]
        model = configs[0][2].get("model", "cloud-model")
        return model, url
    local_name = ui.get_local_model_name()
    return local_name, "http://127.0.0.1:8080"


def run_single_agentic_test(bench: dict, model_name: str, profile_prompt: str) -> tuple[bool, float, int, int, str]:
    orig_cwd = os.getcwd()
    sandbox_dir = tempfile.mkdtemp(prefix="agent_eval_")
    orig_ws = os.environ.get("AI_WORKSPACE_PATH")
    os.environ["AI_WORKSPACE_PATH"] = sandbox_dir
    os.environ["AI_CONFIRM_GATES"] = "0"

    tools.clear_session_tracking()

    if "setup_fn" in bench:
        bench["setup_fn"](sandbox_dir)

    messages = [
        {"role": "system", "content": profile_prompt},
        {"role": "user", "content": bench["prompt"]}
    ]

    configs = cloud.get_active_configs(messages)
    if not configs:
        configs = [("http://localhost:8080/v1/chat/completions", {}, {"messages": messages, "stream": True}, 180)]
    url, headers, body, timeout = configs[0]

    t0 = time.time()
    sink = io.StringIO()
    try:
        with contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
            response = core.agentic_turn(
                messages,
                url,
                headers,
                body,
                timeout,
                spinner=None,
                show_stats=False,
                is_agent=True,
            )
        elapsed = time.time() - t0
        
        turn_count = len([m for m in messages if m.get("role") in ("assistant", "tool")])
        total_tokens = sum(core.get_accurate_token_count(m.get("content") or "") for m in messages)

        passed = bench["verify_fn"](sandbox_dir, response or "")
        detail = f"{elapsed:.2f}s ({turn_count} turns)" if passed else "State verification failed"
        return passed, elapsed, turn_count, total_tokens, detail
    except Exception as e:
        elapsed = time.time() - t0
        return False, elapsed, 0, 0, f"Exception: {str(e)[:30]}"
    finally:
        os.chdir(orig_cwd)
        shutil.rmtree(sandbox_dir, ignore_errors=True)
        if orig_ws:
            os.environ["AI_WORKSPACE_PATH"] = orig_ws
        else:
            os.environ.pop("AI_WORKSPACE_PATH", None)


def main():
    cli_arg = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else None
    prof_name, profile_content = resolve_dynamic_profile(cli_arg)

    console.print(Panel(
        "[bold cyan]Py-Agent Full-Stack Agentic & Tool-Calling Benchmark Suite[/bold cyan]\n"
        "[dim]Testing agent_core, agent_adapters, in-memory /py, surgical edits & exit discipline[/dim]",
        border_style="cyan"
    ))

    model_name, endpoint = get_current_model_info()

    console.print(f"• [bold green]Target Model[/bold green]: [bold]{model_name}[/bold]")
    console.print(f"• [dim]Target Endpoint[/dim]: {endpoint}")
    console.print(f"• [dim]Harness Profile[/dim]: [cyan]{prof_name}[/cyan]\n")

    results = []
    passed_count = 0
    total_time = 0.0
    total_tokens = 0
    spinner = MinimalSpinner()

    try:
        for idx, bench in enumerate(AGENTIC_BENCHMARKS, start=1):
            spinner.start(f"[{idx}/{len(AGENTIC_BENCHMARKS)}] Running \033[1;36m{bench['id']}\033[0m ({bench['name']})...")
            passed, elapsed, turns, toks, detail = run_single_agentic_test(bench, model_name, profile_content)
            spinner.stop()

            total_time += elapsed
            total_tokens += toks
            if passed:
                passed_count += 1
                status_str = "[bold green]PASS[/bold green]"
            else:
                status_str = "[bold red]FAIL[/bold red]"

            tps = (toks / elapsed) if elapsed > 0 else 0
            results.append((bench["id"], bench["name"], bench["tools_tested"], status_str, detail, f"{tps:.1f} t/s"))
            console.print(f"  {'✔' if passed else '✖'} {status_str} : [bold]{bench['id']}[/bold] {bench['name']:<24} {detail:<22} @ [cyan]{tps:.1f} t/s[/cyan]")
    finally:
        spinner.stop()

    accuracy = (passed_count / len(AGENTIC_BENCHMARKS)) * 100
    avg_tps = (total_tokens / total_time) if total_time > 0 else 0

    table = Table(title=f"\nAgentic Stack Benchmark: {model_name} [{prof_name}]", border_style="bright_black")
    table.add_column("ID", style="cyan", justify="left")
    table.add_column("Agent Challenge", style="white")
    table.add_column("Tools Exercised", style="dim")
    table.add_column("Result", justify="center")
    table.add_column("Turn Metrics", style="dim")
    table.add_column("Speed", style="green", justify="right")

    for row in results:
        table.add_row(*row)

    console.print(table)
    score_col = "green" if accuracy >= 80 else "yellow" if accuracy >= 50 else "red"
    console.print(f"\n[bold]Full-Stack Scorecard:[/bold] [{score_col}]{passed_count}/{len(AGENTIC_BENCHMARKS)} Succeeded ({accuracy:.1f}%)[/{score_col}] | Avg Speed: [bold cyan]{avg_tps:.1f} t/s[/bold cyan] | Total Elapsed: [dim]{total_time:.2f}s[/dim]\n")


if __name__ == "__main__":
    main()
