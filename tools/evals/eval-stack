        return configs[0][2].get("model", "cloud-model"), configs[0][0]
    return ui.get_local_model_name(), "http://127.0.0.1:8080"


def _log_failure_trace(
    bench: dict,
    model_name: str,
    profile_name: str,
    messages: list,
    captured_stdout: str,
    sandbox_dir: str,
):
    try:
        os.makedirs(os.path.dirname(FAILURES_LOG), exist_ok=True)
        flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
        fd = os.open(FAILURES_LOG, flags, 0o600)
        with open(fd, "a", encoding="utf-8", errors="replace") as f:
            f.write(f"\n{'='*80}\n")
            f.write(f"FAILED TEST: {bench['id']} - {bench['name']}\n")
            f.write(f"MODEL: {model_name} | PROFILE: {profile_name}\n")
            f.write(f"TIMESTAMP: {time.strftime('%Y-%m-%d %H:%M:%S')}\n")
            f.write(f"{'='*80}\n\n")
            f.write("--- MESSAGE / TOOL CALL HISTORY ---\n")
            for m in messages:
                role = str(m.get("role", "unknown")).upper()
                content = str(m.get("content", ""))
                masked_content = RE_SECRET.sub("[REDACTED]", content)
                f.write(f"[{role}]:\n{masked_content}\n\n")
                if "tool_calls" in m:
                    try:
                        raw_tc = json.dumps(m["tool_calls"], indent=2, default=str)
                        masked_tc = RE_SECRET.sub("[REDACTED]", raw_tc)
                    except Exception as je:
                        masked_tc = f"<unserializable: {je}>"
                    f.write(f"[TOOL_CALLS]: {masked_tc}\n\n")
            f.write("--- CAPTURED AGENT TURNS & STDERR ---\n")
            f.write(RE_SECRET.sub("[REDACTED]", captured_stdout) + "\n")
    except Exception:
        pass


def run_single_agentic_test(
    bench: dict, model_name: str, profile_prompt: str, reasoning_budget: int = 0
) -> tuple[bool, float, int, int, str]:
    orig_cwd = os.getcwd()
    orig_ws = os.environ.get("AI_WORKSPACE_PATH")
    orig_gates = os.environ.get("AI_CONFIRM_GATES")
    sandbox_dir = tempfile.mkdtemp(prefix="agent_eval_")

    t0 = time.time()
    turn_count = 0
    total_tokens = 0
    messages = []
    sink = io.StringIO()

    try:
        os.chdir(sandbox_dir)
        os.environ["AI_WORKSPACE_PATH"] = sandbox_dir
        os.environ["AI_CONFIRM_GATES"] = "0"

        tools.clear_session_tracking()

        # Reset in-memory IPython state completely between benchmarks
        if hasattr(ipython, "_final_answer_val"):
            ipython._final_answer_val = None
        g = getattr(ipython, "_shell_globals", None)
        if isinstance(g, dict):
            g.clear()
        shell = getattr(ipython, "_shell_instance", None)
        if shell is not None and hasattr(shell, "reset"):
            with contextlib.suppress(Exception):
                shell.reset()

        if "setup_fn" in bench:
            bench["setup_fn"](sandbox_dir)

        messages.extend([
            {"role": "system", "content": profile_prompt},
            {"role": "user", "content": bench["prompt"]},
        ])

        configs = cloud.get_active_configs(messages)
        if not configs:
            configs = [("http://localhost:8080/v1/chat/completions", {}, {"messages": messages, "stream": True}, 180)]
        url, headers, body, timeout = configs[0]

        if "max_tokens" not in body:
            body["max_tokens"] = 2048

        if reasoning_budget > 0:
            body["thinking_budget_tokens"] = reasoning_budget
            body["reasoning_budget"] = reasoning_budget
            body["chat_template_kwargs"] = {"enable_thinking": True}

        with contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
            response = core.agentic_turn(
                messages,
                url,
                headers,
                body,
                timeout,
                spinner=None,
                show_stats=False,
                is_agent=True,
            )

        elapsed = time.time() - t0
        turn_count = len([m for m in messages if m.get("role") in ("assistant", "tool")])

        for m in messages:
            total_tokens += core.get_accurate_token_count(m.get("content") or "")
            for tc in m.get("tool_calls", []):
                fn = tc.get("function", {})
                total_tokens += core.get_accurate_token_count(fn.get("name", ""))
                total_tokens += core.get_accurate_token_count(fn.get("arguments", ""))

        passed = False
        try:
            passed = bool(bench["verify_fn"](sandbox_dir, response or ""))
        except Exception as ve:
            passed = False
            sink.write(f"\n[verify_fn exception]: {ve}\n")

        if not passed:
            _log_failure_trace(bench, model_name, profile_prompt, messages, sink.getvalue(), sandbox_dir)

        par_val = bench.get("par_turns", turn_count)
        detail = f"{elapsed:.2f}s ({turn_count}/{par_val}t)" if passed else "State verification failed"
        RUN_TRACES.append({
            "id": bench["id"],
            "name": bench["name"],
            "passed": passed,
            "elapsed_seconds": round(elapsed, 2),
            "turns": turn_count,
            "tokens": total_tokens,
            "messages": [dict(m) for m in messages],
        })
        return passed, elapsed, turn_count, total_tokens, detail
    except Exception as e:
        elapsed = time.time() - t0
        turn_count = len([m for m in messages if m.get("role") in ("assistant", "tool")])
        _log_failure_trace(bench, model_name, profile_prompt, messages, f"{sink.getvalue()}\n[Exception]: {e}", sandbox_dir)
        return False, elapsed, turn_count, total_tokens, f"Exception: {str(e)[:30]}"
    finally:
        with contextlib.suppress(OSError):
            os.chdir(orig_cwd)
        shutil.rmtree(sandbox_dir, ignore_errors=True)
        if orig_ws is not None:
            os.environ["AI_WORKSPACE_PATH"] = orig_ws
        else:
            os.environ.pop("AI_WORKSPACE_PATH", None)

        if orig_gates is not None:
            os.environ["AI_CONFIRM_GATES"] = orig_gates
        else:
            os.environ.pop("AI_CONFIRM_GATES", None)


def main():
    cli_arg = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else None
    prof_name, profile_content = resolve_dynamic_profile(cli_arg)

    skills_dir = os.path.join(CFG_DIR, "skills")
    prof_path = None
    for cand in (
        os.path.join(skills_dir, "profiles", f"{prof_name}.md"),
        os.path.join(skills_dir, "profiles", f"{os.path.basename(prof_name)}.md"),
        os.path.join(skills_dir, f"{prof_name}.md"),
    ):
        if os.path.isfile(cand):
            prof_path = cand
            break

    raw_text = _safe_read(prof_path) if prof_path else profile_content
    meta, body_prompt = skills.parse_frontmatter(raw_text)
    system_prompt = body_prompt or profile_content

    adapters_on = str(meta.get("adapters", meta.get("adp", ""))).lower() in ("true", "1", "yes", "on")
    is_py_enabled = str(meta.get("ipython", meta.get("py", ""))).lower() in ("true", "1", "yes", "on")
    is_purebash_enabled = str(meta.get("purebash", meta.get("miniswe", meta.get("swe", "")))).lower() in ("true", "1", "yes", "on")
    reasoning_budget = int(meta.get("reasoning_budget", 0)) if meta.get("reasoning_budget") else 0

    core.save_state("adapters_active", adapters_on)
    core.save_state("ipython_mode", is_py_enabled)
    core.save_state("purebash_mode", is_purebash_enabled)
    core.save_state("miniswe_mode", is_purebash_enabled)
    core.save_state("reasoning_budget", reasoning_budget)

    console.print(
        Panel(
            "[bold cyan]Py-Agent Full-Stack Agentic & Tool-Calling Benchmark Suite[/bold cyan]\n"
            "[dim]Decision-grade evaluation: Par efficiency, token economy, tool resilience, and execution speed[/dim]",
            border_style="cyan",
        )
    )

    if os.path.isfile(FAILURES_LOG):
        with contextlib.suppress(OSError):
            os.remove(FAILURES_LOG)

    model_name, endpoint = get_current_model_info()

    if is_purebash_enabled:
        mode_label = "Pure Bash (1-Tool Shell)"
    elif is_py_enabled:
        mode_label = "Dual (Python + Native)"
    else:
        mode_label = "Native 6-Tool"

    adp_status = "ON" if adapters_on else "OFF"
    console.print(f"Target Model: [bold]{model_name}[/bold]")
    console.print(f"Target Endpoint: {endpoint}")
    console.print(f"Harness Profile: [cyan]{prof_name}[/cyan] ({mode_label}) [dim][Adapters: {adp_status} | Budget: {reasoning_budget}t][/dim]\n")

    results = []
    passed_count = 0
    total_time = 0.0
    total_tokens = 0
    total_actual_turns = 0
    total_par_turns = 0
    evaluated_count = 0
    task_scores = []
    spinner = MinimalSpinner()
    active_benchmarks = PUREBASH_BENCHMARKS if is_purebash_enabled else AGENTIC_BENCHMARKS

    try:
        for idx, bench in enumerate(active_benchmarks, start=1):
            if bench.get("requires_ipython") and not is_py_enabled:
                results.append((
                    bench["id"],
                    bench["name"],
                    bench["tools_tested"],
                    "[yellow]SKIP[/yellow]",
                    "ipython: OFF",
                    "-",
                    "-",
                ))
                console.print(f"  [-] SKIP : [bold]{bench['id']}[/bold] {bench['name']:<33} (Skipped: /py disabled)")
                continue

            evaluated_count += 1
            par = bench.get("par_turns", 1)
            total_par_turns += par

            spinner.start(f"[{idx}/{len(AGENTIC_BENCHMARKS)}] Running {bench['id']} ({bench['name']})...")
            passed, elapsed, turns, toks, detail = run_single_agentic_test(bench, model_name, system_prompt, reasoning_budget)
            spinner.stop()

            total_time += elapsed
            total_tokens += toks
            total_actual_turns += turns

            if passed:
                passed_count += 1
                status_str = "[bold green]PASS[/bold green]"
                turn_ratio = min(1.0, par / turns) if turns > 0 else 1.0
                task_scores.append(60.0 + (40.0 * turn_ratio))
            else:
                status_str = "[bold red]FAIL[/bold red]"
                task_scores.append(0.0)

            tps = (toks / elapsed) if elapsed > 0 else 0
            turn_metrics = f"{turns}t (Par {par})" if passed else "FAILED"
            results.append((
                bench["id"],
                bench["name"],
                bench["tools_tested"],
                status_str,
                turn_metrics,
                f"{toks:,}t",
                f"{tps:.1f} t/s",
            ))
            console.print(
                f"  {'[green]OK[/green]' if passed else '[red]XX[/red]'} {status_str} : "
                f"[bold]{bench['id']}[/bold] {bench['name']:<33} {detail:<20} @ [cyan]{tps:.1f} t/s[/cyan]"
            )
    finally:
        spinner.stop()

    accuracy = (passed_count / evaluated_count * 100) if evaluated_count > 0 else 0
    par_eff = (total_par_turns / total_actual_turns * 100) if total_actual_turns > 0 else 0
    avg_tps = (total_tokens / total_time) if total_time > 0 else 0
    toks_per_turn = (total_tokens / total_actual_turns) if total_actual_turns > 0 else 0

    # Per-task granular capability: every over-par turn visibly penalizes the composite index
    agent_index = (sum(task_scores) / len(task_scores)) if task_scores else 0.0
    grade = (
        "A+"
        if agent_index >= 95
        else "A"
        if agent_index >= 88
        else "B"
        if agent_index >= 75
        else "C"
        if agent_index >= 60
        else "F"
    )

    table = Table(title=f"\nAgentic Stack Benchmark: {model_name} [{prof_name}]", border_style="bright_black")
    table.add_column("ID", style="cyan", justify="left")
    table.add_column("Agent Challenge", style="white")
    table.add_column("Tools Exercised", style="dim")
    table.add_column("Result", justify="center")
    table.add_column("Turns / Par", justify="center")
    table.add_column("Context", justify="right")
    table.add_column("Speed", style="green", justify="right")

    for row in results:
        table.add_row(*row)

    console.print(table)

    summary_text = Text()
    summary_text.append(
        f"Pass Rate:        {passed_count}/{evaluated_count} ({accuracy:.1f}%)\n",
        style="bold green" if accuracy >= 80 else "bold red",
    )
    summary_text.append(
        f"Par Efficiency:   {par_eff:.1f}% ({total_actual_turns} actual turns / {total_par_turns} par target)\n",
        style="cyan",
    )
    summary_text.append(f"Token Economy:    {total_tokens:,} total tokens (~{toks_per_turn:.0f} tokens/turn)\n", style="dim")
    summary_text.append(
        f"Effective Speed:  {avg_tps:.1f} tokens/second (Total elapsed: {total_time:.2f}s)\n", style="dim"
    )
    summary_text.append(f"\nAgent Performance Index: {agent_index:.1f}/100 [Grade: {grade}]", style="bold yellow")

    console.print(
        Panel(
            summary_text,
            title="Conclusive Benchmark Evaluation",
            border_style="green" if accuracy == 100 else "yellow",
            box=ROUNDED,
        )
    )

    # Atomic history logging with tempfile cleanup guard
    tmp_log = None
    try:
        os.makedirs(os.path.dirname(RESULTS_LOG), exist_ok=True)
        record = {
            "timestamp": int(time.time()),
            "model": model_name,
            "profile": prof_name,
            "accuracy": accuracy,
            "par_efficiency": par_eff,
            "total_tokens": total_tokens,
            "tokens_per_turn": toks_per_turn,
            "avg_tps": avg_tps,
            "total_time": total_time,
            "agent_index": agent_index,
            "grade": grade,
        }
        history = []
        if os.path.isfile(RESULTS_LOG):
            try:
                with open(RESULTS_LOG, "r", encoding="utf-8") as rf:
                    loaded = json.load(rf)
                    if isinstance(loaded, list):
                        history = loaded
            except (json.JSONDecodeError, OSError):
                history = []

        history.append(record)
        tmp_log = f"{RESULTS_LOG}.tmp.{os.getpid()}"
        with open(tmp_log, "w", encoding="utf-8") as wf:
            json.dump(history[-15:], wf, indent=2)
        os.replace(tmp_log, RESULTS_LOG)
        tmp_log = None

        # Auto-pruned full turn traces (keeps last 5 evaluation runs)
        trace_history = []
        if os.path.isfile(TRACES_LOG):
            with contextlib.suppress(Exception):
                with open(TRACES_LOG, "r", encoding="utf-8") as trf:
                    trace_history = json.load(trf)
        trace_history.append({
            "timestamp": int(time.time()),
            "model": model_name,
            "profile": prof_name,
            "accuracy": accuracy,
            "traces": RUN_TRACES,
        })
        tmp_traces = f"{TRACES_LOG}.tmp.{os.getpid()}"
        with open(tmp_traces, "w", encoding="utf-8") as twf:
            json.dump(trace_history[-5:], twf, indent=2)
        os.replace(tmp_traces, TRACES_LOG)
    except Exception:
        pass
    finally:
        if tmp_log and os.path.exists(tmp_log):
            with contextlib.suppress(OSError):
                os.remove(tmp_log)


if __name__ == "__main__":
    main()
