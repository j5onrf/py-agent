class MinimalSpinner:
    def __init__(self):
        self.label = "Working..."
        self.running = False
        self.thread = None
        self.chars = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
        self.target_stream = getattr(sys, "__stderr__", sys.stderr)

    def start(self, label: str = "Working..."):
        self.label = label
        self.running = True
        self.start_time = time.time()
        self.thread = threading.Thread(target=self._spin, daemon=True)
        self.thread.start()

    def _spin(self):
        i = 0
        try:
            self.target_stream.write("\033[?25l")
            self.target_stream.flush()
        except OSError:
            pass

        while self.running:
            elapsed = time.time() - self.start_time
            try:
                self.target_stream.write(
                    f"\r\033[1;36m{self.chars[i % len(self.chars)]}\033[0m {self.label} \033[2m{elapsed:.1f}s\033[0m"
                )
                self.target_stream.flush()
            except OSError:
                pass
            i += 1
            time.sleep(0.08)

    def stop(self):
        self.running = False
        if self.thread and self.thread.is_alive():
            self.thread.join(timeout=0.2)
        try:
            self.target_stream.write("\r\033[2K\r\033[?25h")
            self.target_stream.flush()
        except OSError:
            pass


def _safe_read(path: str) -> str:
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                return f.read()
        except OSError:
            pass
    return ""

