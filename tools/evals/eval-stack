class MinimalSpinner:
    def __init__(self):
        self.label = "Working..."
        self.stop_event = threading.Event()
        self.thread = None
        self.chars = ["-", "\\", "|", "/"]
        self.target_stream = getattr(sys, "__stderr__", sys.stderr)
        self._lock = threading.RLock()  # Re-entrant lock prevents self-deadlock on stop()

    def start(self, label: str = "Working..."):
        with self._lock:
            self.stop()
            self.label = label
            self.stop_event = threading.Event()  # Fresh event per run prevents resurrected threads
            self.start_time = time.time()
            self.thread = threading.Thread(target=self._spin, daemon=True)
            self.thread.start()

    def _spin(self):
        i = 0
        is_tty = getattr(self.target_stream, "isatty", lambda: False)()
        if is_tty:
            try:
                self.target_stream.write("\033[?25l")
                self.target_stream.flush()
            except OSError:
                pass

        while not self.stop_event.is_set():
            if is_tty:
                elapsed = time.time() - self.start_time
                try:
                    self.target_stream.write(
                        f"\r\x1b[2K\033[1;36m[{self.chars[i % len(self.chars)]}]\033[0m {self.label} \033[2m{elapsed:.1f}s\033[0m"
                    )
                    self.target_stream.flush()
                except OSError:
                    pass
            i += 1
            if self.stop_event.wait(0.08):
                break

    def stop(self):
        with self._lock:
            self.stop_event.set()
            t, self.thread = self.thread, None
            if t and t.is_alive():
                t.join(timeout=1.0)
            if getattr(self.target_stream, "isatty", lambda: False)():
                try:
                    self.target_stream.write("\r\033[2K\r\033[?25h")
                    self.target_stream.flush()
                except OSError:
                    pass


def _safe_read(path: str) -> str:
    if os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as f:
                return f.read()
        except OSError:
            pass
    return ""


def _write_fixture(ws: str, fname: str, content: str) -> None:
    target = os.path.join(ws, fname)
    with open(target, "w", encoding="utf-8") as f:
        f.write(content)


def _verify_python_script(script_path: str, cwd: str, timeout: int = 15) -> bool:
    safe_env = {
        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
        "HOME": cwd,
        "PYTHONPATH": cwd,
    }
    try:
        res = subprocess.run(
            [sys.executable, script_path],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=timeout,
            stdin=subprocess.DEVNULL,
            env=safe_env,
        )
        return res.returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        return False


