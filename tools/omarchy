def load_wordmark_banner() -> list[str]:
    """Loads screensaver.txt directly from disk if available, with embedded fallback."""
    if os.path.isfile(SCREENSAVER_TXT):
        try:
            with open(SCREENSAVER_TXT, "r", encoding="utf-8") as f:
                lines = [l.rstrip("\r\n") for l in f if l.rstrip("\r\n")]
            if len(lines) >= 8:
                return lines
        except Exception:
            pass
    return BANNER_FALLBACK


