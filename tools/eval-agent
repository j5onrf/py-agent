def list_available_profiles() -> list[tuple[str, str]]:
    skills_dir = os.path.join(CFG_DIR, "skills")
    profiles_dir = os.path.join(skills_dir, "profiles")
    found = [("default", "Standard HumanEval Coder")]
    
    if os.path.isdir(profiles_dir):
        for root, _, files in os.walk(profiles_dir):
            for f in sorted(files):
                if f.endswith(".md"):
                    full = os.path.join(root, f)
                    rel = os.path.relpath(full, profiles_dir)
                    prof_key = os.path.splitext(rel)[0]
                    if prof_key.startswith("custom/"):
                        lbl = f"Custom {os.path.basename(prof_key).title()}"
                    else:
                        lbl = prof_key.replace("/pro", " Pro").title()
                    found.append((prof_key, lbl))
    return found


def select_profile_interactive(profiles: list[tuple[str, str]], default_key: str = "default") -> str:
    current_idx = 0
    num_opts = len(profiles)
    last_lines = 0

    try:
        tty_in = open("/dev/tty", "r")
        tty_fd = tty_in.fileno()
    except Exception:
        tty_in = None
        tty_fd = sys.stdin.fileno() if sys.stdin.isatty() else None

    def _get_k():
        if tty_fd is not None:
            try:
                old = termios.tcgetattr(tty_fd)
                try:
                    tty.setraw(tty_fd)
                    termios.tcflush(tty_fd, termios.TCIFLUSH)
                    b = os.read(tty_fd, 1)
                    if b == b"\x1b" and select.select([tty_fd], [], [], 0.05)[0]:
                        b += os.read(tty_fd, 2)
                    return b.decode("utf-8", errors="ignore")
                finally:
                    termios.tcsetattr(tty_fd, termios.TCSADRAIN, old)
            except Exception:
                pass
        return ""

    try:
        sys.stderr.write("\033[?25l")
        while True:
            if last_lines > 0:
                sys.stderr.write(f"\033[{last_lines}A\r\033[J")

            lines_count = 0
            sys.stderr.write("\n\033[1;36mSelect Profile to Benchmark:\033[0m \033[2m(↑/↓ navigate, 1-9 select, ↵ run, Esc default)\033[0m\n")
            lines_count += 2

            for idx, (k, lbl) in enumerate(profiles):
                marker = " \033[1;32m★\033[0m" if k == default_key else ""
                if idx == current_idx:
                    sys.stderr.write(f"\033[1;33m  ❯ {idx+1:2d}. {lbl:<26}\033[0m \033[90m({k})\033[0m{marker}\n")
                else:
                    sys.stderr.write(f"\033[37m    {idx+1:2d}. {lbl:<26}\033[0m \033[2m({k})\033[0m{marker}\n")
                lines_count += 1

            sys.stderr.write(f"\n\033[2m:: ↵ run [{profiles[current_idx][1]}]  Esc: default\033[0m\n")
            lines_count += 2
            sys.stderr.flush()

            last_lines = lines_count
            key = _get_k()

            if key in ("\x1b[A", "k", "K"):
                current_idx = (current_idx - 1 + num_opts) % num_opts
            elif key in ("\x1b[B", "j", "J"):
                current_idx = (current_idx + 1) % num_opts
            elif key.isdigit() and 1 <= int(key) <= num_opts:
                current_idx = int(key) - 1
                break
            elif key in ("\r", "\n", ""):
                break
            elif key in ("\x03", "\x1b", "q", "Q"):
                current_idx = 0
                break

        sys.stderr.write(f"\033[{last_lines}A\r\033[J")
        sys.stderr.flush()
        return profiles[current_idx][0]
    finally:
        sys.stderr.write("\033[?25h")
        sys.stderr.flush()
        if tty_in:
            try:
                tty_in.close()
            except Exception:
                pass


def resolve_dynamic_profile(cli_profile_arg: str | None = None) -> tuple[str, str]:
    skills_dir = os.path.join(CFG_DIR, "skills")
    
    # 1. CLI argument
    if cli_profile_arg and not cli_profile_arg.startswith("-"):
        clean_arg = cli_profile_arg.lstrip("-")
        content = skills.load_skill_content(clean_arg, skills_dir, CFG_DIR)
        if content:
            return clean_arg, content
        if not clean_arg.startswith("custom/"):
            content = skills.load_skill_content(f"custom/{clean_arg}", skills_dir, CFG_DIR)
            if content:
                return f"custom/{clean_arg}", content

    # 2. Workspace config
    ws_path = os.environ.get("AI_WORKSPACE_PATH", os.getcwd())
    cfg_file = os.path.join(ws_path, ".agent", "config.json")
    if os.path.isfile(cfg_file):
        try:
            with open(cfg_file, "r", encoding="utf-8") as cf:
                saved_prof = json.load(cf).get("profile", "")
                if saved_prof:
                    content = skills.load_skill_content(saved_prof, skills_dir, CFG_DIR)
                    if content:
                        return saved_prof, content
        except Exception:
            pass

    # 3. Interactive Menu
    if not os.environ.get("AI_CONTEXT_RUN"):
        profiles = list_available_profiles()
        if profiles:
            chosen_key = select_profile_interactive(profiles, "default")
            if chosen_key != "default":
                content = skills.load_skill_content(chosen_key, skills_dir, CFG_DIR)
                if content:
                    return chosen_key, content

    default_sys = "You are an expert Python programming assistant. Write clean, correct, self-contained Python code. Output ONLY the python code block with no conversational text."
    return "Standard Coder", default_sys


def extract_python_code(raw_response: str) -> str:
    clean = re.sub(r"<think>[\s\S]*?</think>", "", raw_response).strip()
    if m := re.search(r"```(?:python)?\s*([\s\S]*?)\s*```", clean, re.IGNORECASE):
        return m.group(1).strip()
    return clean


def run_single_test(bench: dict, model_name: str, sys_prompt: str) -> tuple[bool, float, int, str]:
    messages = [
        {"role": "system", "content": sys_prompt},
        {"role": "user", "content": bench["prompt"]}
    ]
    
    t0 = time.time()
    response = None
    
    # 2-attempt loop to absorb server KV-cache reset pauses
    for attempt in range(2):
        sink = io.StringIO()
        try:
            with contextlib.redirect_stdout(sink), contextlib.redirect_stderr(sink):
                response = core.stream_response(messages, prefix="AI:", show_stats=False, thinking_budget=0)
            if response:
                break
        except Exception:
            pass
        if attempt == 0:
            time.sleep(0.4)
        
    elapsed = time.time() - t0
    
    if not response:
        return False, elapsed, 0, "Empty response"
    
    code = extract_python_code(response)
    toks = core.get_accurate_token_count(response)
    
    test_harness = f"{code}\n\n{bench['test_code']}"
    
    sandbox_dir = tempfile.mkdtemp(prefix="he_eval_")
    test_file = os.path.join(sandbox_dir, "test_eval.py")
    
    try:
        with open(test_file, "w", encoding="utf-8") as f:
            f.write(test_harness)
        
        r = subprocess.run([sys.executable, test_file], capture_output=True, text=True, timeout=5)
        passed = (r.returncode == 0)
        err_msg = r.stderr.strip().splitlines()[-1] if r.stderr else ""
        return passed, elapsed, toks, err_msg
    except subprocess.TimeoutExpired:
        return False, elapsed, toks, "Execution Timed Out (>5s)"
    except Exception as e:
        return False, elapsed, toks, str(e)
    finally:
        shutil.rmtree(sandbox_dir, ignore_errors=True)


def get_current_model_info() -> tuple[str, str]:
    configs = cloud.get_active_configs([])
    if configs:
        url = configs[0][0]
        model = configs[0][2].get("model", "cloud-model")
        return model, url
    local_name = ui.get_local_model_name()
    return local_name, "http://127.0.0.1:8080"


def main():
    cli_arg = sys.argv[1] if len(sys.argv) > 1 and not sys.argv[1].startswith("-") else None
    prof_name, profile_prompt = resolve_dynamic_profile(cli_arg)

    console.print(Panel(
        "[bold cyan]Py-Agent HumanEval & Code Quality Benchmark Suite[/bold cyan]\n"
        "[dim]Deterministic assertion verification & tokens/sec speed testing[/dim]",
        border_style="cyan"
    ))
    
    model_name, endpoint = get_current_model_info()
    
    console.print(f"• [bold green]Active Target Model[/bold green]: [bold]{model_name}[/bold]")
    console.print(f"• [dim]Target Endpoint[/dim]: {endpoint}")
    console.print(f"• [dim]System Profile[/dim]: [cyan]{prof_name}[/cyan]\n")
    
    results = []
    passed_count = 0
    total_tokens = 0
    total_time = 0.0
    spinner = MinimalSpinner()
    
    try:
        for idx, bench in enumerate(BENCHMARKS, start=1):
            spinner.start(f"[{idx}/{len(BENCHMARKS)}] Evaluating \033[1;36m{bench['id']}\033[0m ({bench['name']})...")
            passed, elapsed, toks, err = run_single_test(bench, model_name, profile_prompt)
            spinner.stop()
            
            total_tokens += toks
            total_time += elapsed
            if passed:
                passed_count += 1
                status_str = "[bold green]PASS[/bold green]"
                detail = f"{elapsed:.2f}s ({toks}t)"
            else:
                status_str = "[bold red]FAIL[/bold red]"
                detail = f"[dim red]{err[:32]}[/dim red]"
                
            tps = (toks / elapsed) if elapsed > 0 else 0
            results.append((bench["id"], bench["name"], bench["category"], status_str, detail, f"{tps:.1f} t/s"))
            
            console.print(f"  {'✔' if passed else '✖'} {status_str} : [bold]{bench['id']}[/bold] {bench['name']:<25} {detail:<22} @ [cyan]{tps:.1f} t/s[/cyan]")
            
            # 0.25s pause to allow local server to reclaim KV-cache slot cleanly
            time.sleep(0.25)
    finally:
        spinner.stop()
    
    accuracy = (passed_count / len(BENCHMARKS)) * 100
    avg_tps = (total_tokens / total_time) if total_time > 0 else 0
    
    table = Table(title=f"\nBenchmark Results: {model_name} [{prof_name}]", border_style="bright_black")
    table.add_column("ID", style="cyan", justify="left")
    table.add_column("Problem", style="white")
    table.add_column("Domain", style="dim")
    table.add_column("Result", justify="center")
    table.add_column("Details", style="dim")
    table.add_column("Speed", style="green", justify="right")
    
    for row in results:
        table.add_row(*row)
        
    console.print(table)
    
    score_color = "green" if accuracy >= 80 else "yellow" if accuracy >= 50 else "red"
    console.print(f"\n[bold]Final Scorecard:[/bold] [{score_color}]{passed_count}/{len(BENCHMARKS)} Passed ({accuracy:.1f}%)[/{score_color}] | Avg Speed: [bold cyan]{avg_tps:.1f} t/s[/bold cyan] | Total Time: [dim]{total_time:.2f}s[/dim]\n")


if __name__ == "__main__":
    main()
