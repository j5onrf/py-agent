#!/usr/bin/env bash
# aur-audit - Interactive Zero-Trust AUR Package Auditor

set -euo pipefail
export LC_ALL=C

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/py-agent"
[[ -d "$CFG_DIR" ]] || CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/local-ai"

AUDIT_SKILL_FILE="${CFG_DIR}/skills/system/aur-audit.md"
ALIAS_AI_SCRIPT="${CFG_DIR}/ai-agent.py"

# 1. Display Dedicated Audit Skill Profile
if [[ -f "$AUDIT_SKILL_FILE" ]]; then
    printf "> [AUR Audit Directives]:\n\`\`\`markdown\n"
    head -c 16384 "$AUDIT_SKILL_FILE"
    printf "\n\`\`\`\n\n---\n\n"
fi

# 2. Package Name Resolution
PKG_NAME="${1:-}"
if [[ -z "$PKG_NAME" ]]; then
    read -r -e -p "❯ Enter AUR package name to audit: " PKG_NAME || { echo "Cancelled." >&2; exit 1; }
fi

PKG_NAME="$(echo "${PKG_NAME}" | tr -d '[:space:]')"

if [[ -z "$PKG_NAME" ]]; then
    printf "❌ Error: No package name was provided.\n" >&2
    exit 1
fi

if [[ ! "$PKG_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_@.+-]*$ ]]; then
    printf "❌ Error: Invalid package name format: '%s'\n" "$PKG_NAME" >&2
    exit 1
fi

# 3. Secure Clone
TEMP_DIR="$(mktemp -d)"
cleanup() {
    rm -rf "$TEMP_DIR"
}
trap cleanup EXIT
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM

printf "⠋ Fetching AUR repository for: \033[1;33m%s\033[0m...\r" "$PKG_NAME" >&2

git clone --depth 1 "https://aur.archlinux.org/${PKG_NAME}.git" "$TEMP_DIR" >/dev/null 2>&1 &
CLONE_PID=$!

spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
i=0
while kill -0 "$CLONE_PID" 2>/dev/null; do
    i=$(( (i + 1) % 10 ))
    printf "\r%s Fetching AUR repository for: \033[1;33m%s\033[0m..." "${spin:$i:1}" "$PKG_NAME" >&2
    sleep 0.08
done

wait "$CLONE_PID" || {
    printf "\r\033[2K❌ [CRITICAL ERROR] Failed to retrieve package data for '%s'.\n" "$PKG_NAME" >&2
    printf "   Verify package exists on https://aur.archlinux.org\n" >&2
    exit 1
}

printf "\r\033[2K" >&2

# 4. Extract Package Metadata (.SRCINFO)
METADATA=""
if [[ -f "$TEMP_DIR/.SRCINFO" ]]; then
    while IFS='=' read -r key val; do
        key="$(echo "$key" | tr -d '[:space:]')"
        val="$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        if [[ -n "$key" && -n "$val" ]]; then
            case "$key" in
                pkgdesc)       METADATA+="* **Description**: ${val}"$'\n' ;;
                pkgver)        METADATA+="* **Version**: ${val}"$'\n' ;;
                url)           METADATA+="* **Upstream URL**: \`${val}\`"$'\n' ;;
                license)       METADATA+="* **License**: ${val}"$'\n' ;;
                depends)       METADATA+="* **Runtime Dep**: \`${val}\`"$'\n' ;;
                makedepends)   METADATA+="* **Build Dep**: \`${val}\`"$'\n' ;;
                source)        METADATA+="* **Declared Source**: \`${val}\`"$'\n' ;;
                install)       METADATA+="* **Install Scriptlet**: \`${val}\`"$'\n' ;;
                sha256sums)    METADATA+="* **SHA256**: \`${val}\`"$'\n' ;;
            esac
        fi
    done < "$TEMP_DIR/.SRCINFO"
fi

if [[ ! -f "$TEMP_DIR/PKGBUILD" ]]; then
    printf "❌ Error: PKGBUILD not found in cloned repository.\n" >&2
    exit 1
fi
PKGBUILD_CONTENT="$(head -c 65536 "$TEMP_DIR/PKGBUILD")"

# Discover all supplementary scripts (.install, .service, .sh)
ANCILLARY_SCRIPTS=""
while IFS= read -r -d '' asset; do
    base="$(basename "$asset")"
    if [[ "$base" != "PKGBUILD" && "$base" != ".SRCINFO" && ! -d "$asset" ]]; then
        if file "$asset" 2>/dev/null | grep -qv "text"; then
            ANCILLARY_SCRIPTS+=$'\n\n'"#### [Binary File Asset]: \`${base}\`"$'\n'"*(Omitted binary blob)*"
        else
            content="$(head -c 32768 "$asset")"
            ANCILLARY_SCRIPTS+=$'\n\n'"#### [Embedded Script]: \`${base}\`"$'\n\`\`\`bash\n'"${content}"$'\n\`\`\`'
        fi
    fi
done < <(find "$TEMP_DIR" -maxdepth 1 -not -name '.git' -print0)

# 5. Formulate Zero-Trust Audit Prompt
PROMPT="Please perform a comprehensive zero-trust security audit on this AUR package build recipe.

### Zero-Trust Evaluation Checklist:
1. **Network Integrity**: Check if build() or package() initiates arbitrary external network downloads bypassing source array.
2. **Obfuscation & Sudo**: Flag any hidden base64 decoding, eval, curl | bash, chown/chmod root escalations, or telemetry hooks.
3. **Upstream Authenticity**: Verify whether the declared source download URL matches the authentic developer repository.
4. **Install Hook Safety**: Inspect pre/post-install routines for persistent daemon installation or crontab modifications.

### 1. Package Metadata Overview
$METADATA

### 2. Primary PKGBUILD Recipe
\`\`\`bash
$PKGBUILD_CONTENT
\`\`\`"

if [[ -n "$ANCILLARY_SCRIPTS" ]]; then
    PROMPT+=$'\n\n'"### 3. Ancillary Package Scripts & Install Hooks${ANCILLARY_SCRIPTS}"
fi

# 6. Dispatch safely via STDIN to eliminate Linux E2BIG argv overflow
if [[ "${AI_CONTEXT_RUN:-0}" != "0" ]]; then
    printf "%s\n" "$PROMPT"
else
    printf "\033[2m[sys] Auditing '%s' with zero-trust AI profile...\033[0m\n" "$PKG_NAME" >&2
    printf "%s\n" "$PROMPT" | python3 "$ALIAS_AI_SCRIPT" --talk - --aur-audit
fi
