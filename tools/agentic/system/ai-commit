#!/usr/bin/env bash
# ai-commit - Automate Git Commits with AI Context

set -euo pipefail

if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
    trap 'echo -e "\n\n👋 Commit aborted."; return 130 2>/dev/null || exit 130' INT
else
    trap 'echo -e "\n\n👋 Commit aborted."; exit 130' INT
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "❌ Error: Not inside a git repository." >&2
    exit 1
fi

stats=$(git diff --cached --name-status | head -n 8 || true)
if [[ -z "$stats" ]]; then
    echo "⚠️  No staged changes found. Run 'git add' on your files first." >&2
    exit 0
fi

_AI_SCRIPT_PATH="$HOME/.config/py-agent/ai-agent.py"
_AI_PYTHON_BIN=$(command -v python3 2>/dev/null || type -p python3 2>/dev/null || echo "python3")

changes=$(git diff --cached -U0 -- \
    ':(exclude)*lock*' ':(exclude)*.svg' ':(exclude)*.png' ':(exclude)*.jpg' ':(exclude)*.gif' \
    | awk '
    /^\+[^+]/ || /^-[^-]/ {
        val = substr($0, 2)
        sub(/^[ \t]+/, "", val)
        if (val != "" && val !~ /^(#|\/\/|\/\*|\*)/) {
            print $0
            count++
            if (count >= 15) { exit }
        }
    }' || true)

PROMPT="Write a short git commit message (4 to 8 words) for these staged changes.

Rules:
- Length: 4 to 8 words. Complete thought, do not trail off.
- Format: Imperative mood starting with Add, Fix, Update, Refactor, or Remove.
- Output ONLY the commit line. No quotes, no explanations, no trailing period.

Good examples:
- Add user authentication middleware
- Fix broken pipe on stream disconnect
- Update launch script for background server
- Refactor database query to improve performance

Staged files:
$stats

Diff:
$changes"

tmp_out=$(mktemp)
"$_AI_PYTHON_BIN" "$_AI_SCRIPT_PATH" --talk "$PROMPT" > "$tmp_out" 2>/dev/null &
pid=$!

spin='⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏'
i=0
while kill -0 "$pid" 2>/dev/null; do
    i=$(( (i + 1) % 10 ))
    printf "\r\033[1;32m%s\033[0m \033[36mGenerating commit message...\033[0m " "${spin:$i:1}" >&2
    sleep 0.08
done
wait "$pid" 2>/dev/null || true
printf "\r\033[2K" >&2

raw_message=$(cat "$tmp_out" 2>/dev/null || echo "")
rm -f "$tmp_out"

# 1. Strip <think>...</think> reasoning blocks across multiple lines
message=$(echo "$raw_message" | perl -0777 -pe 's/<think>.*?<\/think>//gs' 2>/dev/null || echo "$raw_message")

# 2. Extract the first non-empty line and strip prefixes/markdown
message=$(echo "$message" | sed -E \
    -e 's/^[Cc]ommit [Mm]essage:?\s*//' \
    -e 's/^[-*]\s*//' \
    -e 's/^[`"'\''\s]+//' \
    -e 's/[`"'\''\s\.]+$//' \
    -e 's/^[[:space:]]+//; s/[[:space:]]+$//' \
    | grep -v '^$' | head -n 1)

# 3. If model still produced a long sentence (>8 words), safely truncate and strip dangling prepositions
if [[ -n "$message" ]]; then
    word_count=$(echo "$message" | wc -w)
    if [[ $word_count -gt 8 ]]; then
        # Take first 8 words
        message=$(echo "$message" | awk '{for(i=1;i<=8;i++) printf "%s%s", $i, (i<8?" ":"\n")}')
        # Strip trailing prepositions/conjunctions to prevent hanging sentences ("in", "to", "for", "and", etc.)
        message=$(echo "$message" | sed -E 's/\s+(in|to|for|with|and|or|the|a|an|of|by|from|on|at|as)$//I')
    fi
fi

# Fallback & Capitalization
if [[ -z "$message" ]]; then
    message="Update staged files"
else
    first_char=$(echo "${message:0:1}" | tr '[:lower:]' '[:upper:]')
    message="${first_char}${message:1}"
fi

echo -e "\nAI-Commit (Edit inline with arrows/backspace, then press Enter):"

read -e -i "$message" -p "Commit message: " user_message

if [[ -z "$user_message" ]]; then
    echo "❌ Error: Commit message cannot be empty. Aborting." >&2
    exit 1
fi

git commit -m "$user_message"
