#!/usr/bin/env bash
# security-audit - Dynamic Security Profile Integrator & System Auditor

set -euo pipefail
export LC_ALL=C

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/py-agent"
[[ -d "$CONFIG_DIR" ]] || CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/local-ai"

SECAUD_FILE="${CONFIG_DIR}/skills/system/security-audit.md"
MYSYS_FILE="${CONFIG_DIR}/skills/system/mysys.md"

if [[ -f "$MYSYS_FILE" ]]; then
    printf "> [Host Environment Spec]:\n\`\`\`markdown\n"
    head -c 16384 "$MYSYS_FILE"
    printf "\n\`\`\`\n\n---\n\n"
fi

if [[ -f "$SECAUD_FILE" ]]; then
    printf "> [Security Auditor Directives]:\n\`\`\`markdown\n"
    head -c 16384 "$SECAUD_FILE"
    printf "\n\`\`\`\n\n---\n\n"
fi

printf "## REAL-TIME SYSTEM SECURITY DIAGNOSTICS\n\n"

# 1. Kernel Alignment & Integrity
LOCAL_KERNEL=$(uname -r)
STABLE_KERNEL=$(python3 -c '
import urllib.request as urlreq, json
try:
    req = urlreq.Request("https://www.kernel.org/releases.json", headers={"User-Agent": "secaud-agent/2.0"})
    with urlreq.urlopen(req, timeout=3.0) as r:
        releases = json.loads(r.read().decode())["releases"]
        for rel in releases:
            if rel.get("moniker") == "stable":
                print(rel.get("version", "None"))
                break
except Exception:
    print("None")
' 2>/dev/null || echo "None")

printf "### 1. Upstream Kernel Alignment\n"
printf "* Running Local Kernel: \`%s\`\n" "$LOCAL_KERNEL"

if [[ "$STABLE_KERNEL" != "None" && -n "$STABLE_KERNEL" ]]; then
    printf "* Latest Upstream Stable: \`%s\`\n" "$STABLE_KERNEL"
    IFS='.' read -r l1 l2 _ <<< "$LOCAL_KERNEL"
    IFS='.' read -r s1 s2 _ <<< "$STABLE_KERNEL"
    l1="${l1//[^0-9]/}"; l2="${l2//[^0-9]/}"
    s1="${s1//[^0-9]/}"; s2="${s2//[^0-9]/}"

    if [[ -n "$l1" && -n "$l2" && -n "$s1" && -n "$s2" ]]; then
        if (( 10#$l1 < 10#$s1 || ( 10#$l1 == 10#$s1 && 10#$l2 < 10#$s2 ) )); then
            printf "* Upstream Status: **Behind** upstream stable %s.%s. Verify security backports.\n" "$s1" "$s2"
        else
            printf "* Upstream Status: Inline or ahead of upstream stable branch.\n"
        fi
    fi
else
    printf "* Upstream Status: Kernel verification service unreachable (offline or DNS timeout).\n"
fi
printf "\n"

# 2. Systemd Services Attack Surface
TOTAL_SERVICES=$(systemctl list-units --type=service --state=running --plain --no-legend 2>/dev/null | awk 'NF {c++} END {print c+0}')
printf "### 2. Systemd Services Attack Surface\n"
printf "* Active Running Services: \`%d\`\n" "$TOTAL_SERVICES"

for srv in systemd-resolved avahi-daemon sshd bluetooth; do
    if systemctl is-active "$srv" >/dev/null 2>&1; then
        printf "* \`%s.service\`: **ACTIVE** (Exposes background vector)\n" "$srv"
    fi
done
printf "\n"

# 3. Sandbox Profiles
FLATPAK_COUNT=0
if command -v flatpak >/dev/null 2>&1; then
    FLATPAK_COUNT=$(flatpak list 2>/dev/null | awk 'NF {c++} END {print c+0}')
fi

SNAP_CLASSIC=0
if command -v snap >/dev/null 2>&1; then
    SNAP_CLASSIC=$(snap list 2>/dev/null | grep -c "classic" || echo "0")
fi

printf "### 3. Containerized Application Sandboxing\n"
printf "* Installed Flatpaks: \`%d\`\n" "$FLATPAK_COUNT"
printf "* Snaps with Classic Confinement: \`%d\`\n\n" "$SNAP_CLASSIC"

# 4. Privilege & SSH Identity Surface
printf "### 4. Host Privilege & Identity Surface\n"
if sudo -n true 2>/dev/null; then
    printf "* Passwordless Sudo: **ENABLED** (User escalates without password verification)\n"
else
    printf "* Passwordless Sudo: DISABLED (Password authentication enforced)\n"
fi
printf "* Default File Umask: \`%s\`\n" "$(umask)"

SSH_DIR="$HOME/.ssh"
if [[ -d "$SSH_DIR" ]]; then
    SSH_PERM=$(stat -c "%a" "$SSH_DIR" 2>/dev/null || echo "Unknown")
    printf "* SSH Directory Permissions: \`%s\` on \`~/.ssh\`\n" "$SSH_PERM"
    if [[ "$SSH_PERM" != "700" ]]; then
        printf "  - **WARNING**: SSH directory should be set to \`700\`.\n"
    fi

    INSECURE_KEYS=$(find "$SSH_DIR" -type f ! -name "*.pub" ! -name "known_hosts*" ! -name "authorized_keys*" \( -perm /077 -o -perm /044 \) 2>/dev/null || true)
    if [[ -n "$INSECURE_KEYS" ]]; then
        printf "  - **CRITICAL ALERT**: Over-permissive private key(s) detected:\n"
        while IFS= read -r k; do
            clean_k="${k/$HOME/[home]}"
            printf "    - \`%s\`\n" "$clean_k"
        done <<< "$INSECURE_KEYS"
    fi
fi

# SUID Search bounded to 10 seconds and depth 4
SUID_TRAPS=$(timeout 10 find "$HOME" /tmp -xdev -maxdepth 4 \( -perm -4000 -o -perm -2000 \) -type f 2>/dev/null | head -n 30 || true)
if [[ -n "$SUID_TRAPS" ]]; then
    printf "* **CRITICAL**: SUID/SGID binary located in user/temp directory:\n"
    while IFS= read -r b; do
        clean_b="${b/$HOME/[home]}"
        printf "  - \`%s\`\n" "$clean_b"
    done <<< "$SUID_TRAPS"
fi
printf "\n"

# 5. Network Listeners & Local Firewall
printf "### 5. Network Listeners & Local Firewall\n"
FW_ACTIVE="DISABLED"
for fw in ufw firewalld nftables iptables; do
    if systemctl is-active "$fw" >/dev/null 2>&1; then
        FW_ACTIVE="ENABLED ($fw active)"
        break
    fi
done

if [[ "$FW_ACTIVE" == "DISABLED" ]]; then
    if nft list ruleset 2>/dev/null | grep -q "^table" || sudo -n nft list ruleset 2>/dev/null | grep -q "^table"; then
        FW_ACTIVE="ENABLED (Active nftables ruleset in kernel)"
    elif ! sudo -n true 2>/dev/null; then
        FW_ACTIVE="UNKNOWN (Ruleset inspection requires privileges)"
    fi
fi
printf "* Active Firewall Service: **%s**\n" "$FW_ACTIVE"

# In AI context mode (AI_CONTEXT_RUN != 0), omit process metadata to prevent fingerprinting
if [[ "${AI_CONTEXT_RUN:-0}" != "0" ]]; then
    RAW_PORTS=$(ss -tulnH 2>/dev/null | grep -E '0\.0\.0\.0|\*|\[::\]' | awk '{print $1 " on " $5}' || true)
    PUBLIC_PORTS=$(echo "$RAW_PORTS" | sed -E \
        -e 's/127\.[0-9]+\.[0-9]+\.[0-9]+/[localhost]/g' \
        -e 's/192\.168\.[0-9]+\.[0-9]+/[private-ip]/g' \
        -e 's/172\.(1[6-9]|2[0-9]|3[0-1])\.[0-9]+\.[0-9]+/[private-ip]/g' \
        -e 's/10\.[0-9]+\.[0-9]+\.[0-9]+/[private-ip]/g' \
        -e 's/0\.0\.0\.0/[all-interfaces]/g' \
        -e 's/\*/[all-interfaces]/g' \
        -e 's/\[::1\]/[localhost]/g' \
        -e 's/\[::\]/[all-interfaces]/g' \
        -e 's/\[?fe80:[a-fA-F0-9:]*\]?/[link-local]/g')
else
    PUBLIC_PORTS=$(ss -tulnpH 2>/dev/null | grep -E '0\.0\.0\.0|\*|\[::\]' | awk '{print $1 " on " $5 " (" $7 ")"}' || true)
fi

PUBLIC_COUNT=$(awk 'NF {c++} END {print c+0}' <<< "$PUBLIC_PORTS")
printf "* Active Public Network Listeners: \`%d\`\n" "$PUBLIC_COUNT"
if (( PUBLIC_COUNT > 0 )); then
    while IFS= read -r line; do
        [[ -n "$line" ]] && printf "  - \`%s\`\n" "$line"
    done <<< "$PUBLIC_PORTS"
fi
printf "\n"

# 6. Foreign (AUR) Packages & Live Blacklist Audit
printf "### 6. Foreign (AUR) Live Blacklist & Heuristic Audit\n"
AUR_PACKAGES=$(pacman -Qm 2>/dev/null || true)
AUR_COUNT=$(awk 'NF {c++} END {print c+0}' <<< "$AUR_PACKAGES")
printf "* Total Foreign/AUR Packages: \`%d\`\n" "$AUR_COUNT"

if (( AUR_COUNT > 0 )); then
    python3 - "$AUR_PACKAGES" << 'EOF'
import urllib.request as urlreq, urllib.parse, json, time, sys, re

raw_pkgs = sys.argv[1]
pkgs = [line.split()[0] for line in raw_pkgs.splitlines() if line.strip()]
if not pkgs:
    sys.exit(0)

compromised = set()
blacklist_ok = False
try:
    url = "https://md.archlinux.org/s/SxbqukK6IA"
    req = urlreq.Request(url, headers={"User-Agent": "Mozilla/5.0"})
    with urlreq.urlopen(req, timeout=3.0) as r:
        raw_text = r.read().decode("utf-8")
        for line in raw_text.splitlines():
            line_clean = line.strip().strip("-`* ")
            if re.fullmatch(r"[a-z0-9][a-z0-9._+-]{1,}", line_clean):
                compromised.add(line_clean)
        blacklist_ok = True
except Exception:
    pass

results = []
rpc_ok = False
batch_size = 50
for i in range(0, len(pkgs), batch_size):
    batch = pkgs[i:i+batch_size]
    params = [("arg[]", p) for p in batch]
    url = "https://aur.archlinux.org/rpc/v5/info?" + urllib.parse.urlencode(params)
    try:
        req = urlreq.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urlreq.urlopen(req, timeout=3.5) as r:
            data = json.loads(r.read().decode())
            if "results" in data:
                results.extend(data["results"])
                rpc_ok = True
    except Exception:
        pass

metadata = {res.get("Name"): res for res in results}
warnings = []
keywords = ["network", "daemon", "server", "ssh", "ssl", "api", "remote", "socket", "download", "http", "proxy"]

for pkg in pkgs:
    if pkg in compromised:
        warnings.append(f"  - `[CRITICAL]` `{pkg}`: Matches live Arch Linux compromised packages list! Remove immediately.")
        continue

    meta = metadata.get(pkg)
    if not meta:
        if rpc_ok:
            warnings.append(f"  - `[WARNING]` `{pkg}`: Missing from the AUR database (may have been deleted or renamed).")
        continue

    desc = meta.get("Description", "").lower()
    votes = meta.get("NumVotes", 0)
    is_orphan = not meta.get("Maintainer")
    is_out_of_date = meta.get("OutOfDate") is not None
    last_modified = meta.get("LastModified", 0)

    age_days = (time.time() - last_modified) / 86400.0
    has_sensitive = any(kw in desc for kw in keywords)

    if votes < 50 and age_days < 14:
        reasons = []
        if is_orphan: reasons.append("orphaned")
        if is_out_of_date: reasons.append("out-of-date")
        if has_sensitive: reasons.append("network hooks")
        reason_str = " & ".join(reasons) if reasons else "unvetted code changes"
        warnings.append(f"  - `[HIGH RISK]` `{pkg}` (votes: {votes}): Modified recently ({age_days:.1f}d ago) with low trust metrics ({reason_str}).")

if warnings:
    print("* Security Alerts & Risks Identified:")
    for w in warnings:
        print(w)
else:
    if blacklist_ok:
        cur_date = time.strftime("%B %Y")
        print(f"* **Active Threat Scan**: SECURE. Successfully verified against the Arch Linux {cur_date} Blacklist.")
    else:
        print("* **Active Threat Scan**: INCOMPLETE (Arch Linux live blacklist service unreachable).")
EOF
fi
printf "\n"

# 7. Pacman Transaction Log
printf "### 7. Pacman Activity Log Audit\n"
if [[ -f "/var/log/pacman.log" && "$AUR_COUNT" -gt 0 ]]; then
    DATE_PATTERNS=()
    for i in {0..14}; do
        if d_str=$(date -d "$i days ago" "+%Y-%m-%d" 2>/dev/null); then
            DATE_PATTERNS+=("\[$d_str")
        fi
    done

    if (( ${#DATE_PATTERNS[@]} > 0 )); then
        REGEX_DAYS=$(IFS="|"; echo "${DATE_PATTERNS[*]}")
        RECENT_AUR_LOGS=$(grep -E "$REGEX_DAYS" /var/log/pacman.log 2>/dev/null | grep -E "installed|upgraded" | grep -Ff <(pacman -Qmq) | head -n 40 || true)
        if [[ -n "$RECENT_AUR_LOGS" ]]; then
            printf "* Recent foreign package transactions (last 14 days):\n"
            while IFS= read -r line; do printf "  - %s\n" "$line"; done <<< "$RECENT_AUR_LOGS"
        else
            printf "* No foreign packages installed or upgraded within the last 14 days.\n"
        fi
    fi
else
    printf "* Pacman logs unavailable or no foreign packages installed.\n"
fi
printf "\n"

# 8. Local Helper Build Cache Scan
printf "### 8. Local Helper Build Cache Scan\n"
SUSPICIOUS_REGEX="(curl|wget).+\| *(bash|sh|python|perl|node|bun)|(npm|bun|pip|cargo) +install|base64 +-d|eval +\\\$\(|atomic-lockfile|temp\.sh"

TARGET_CACHE_DIRS=()
for candidate in yay paru aurutils cachyos-repo-manager; do
    [[ -d "$HOME/.cache/$candidate" ]] && TARGET_CACHE_DIRS+=("$HOME/.cache/$candidate")
done

if (( ${#TARGET_CACHE_DIRS[@]} > 0 )); then
    SUSPICIOUS_HITS=$(find "${TARGET_CACHE_DIRS[@]}" -maxdepth 4 -type f -name "PKGBUILD" -exec grep -inE "$SUSPICIOUS_REGEX" {} + 2>/dev/null | head -n 30 || true)
    if [[ -n "$SUSPICIOUS_HITS" ]]; then
        printf "* [CRITICAL] Suspicious installation signatures identified in local build caches:\n"
        while IFS= read -r hit; do
            clean_hit="${hit/$HOME/[home]}"
            printf "  - %s\n" "$clean_hit"
        done <<< "$SUSPICIOUS_HITS"
    else
        printf "* No suspicious installation hooks or network bypass triggers detected in active build caches.\n"
    fi
else
    printf "* NOT_SCANNED: No supported helper cache directories found under ~/.cache.\n"
fi
printf "\n"
