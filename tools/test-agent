    p5_f = "test_script.py" in res_l and is_bounded and "test_script.py" in res_l_empty
    print_result("list_dir (In-Bounds Path Resolution)", p5_f, f"Entries: {res_l.splitlines()}")

    # 7. Subprocess execution
    old_gates = os.environ.get("AI_CONFIRM_GATES")
