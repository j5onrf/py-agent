#!/usr/bin/env python3
"""Unified All-in-One Local-AI Diagnostic & Live Functional Suite"""

import importlib
import json
import os
import py_compile
import shutil
import subprocess
import sys
import tempfile

CFG_DIR = os.path.expanduser("~/.config/py-agent")
sys.path.insert(0, os.path.join(CFG_DIR, "modules"))
sys.path.insert(0, CFG_DIR)

GREEN, RED, CYAN, YELLOW, RESET = (
    "\033[1;32m",
    "\033[1;31m",
    "\033[1;36m",
    "\033[1;33m",
    "\033[0m",
)


def print_result(name: str, passed: bool, detail: str = ""):
    if passed:
        print(f"  {GREEN}✔ PASS{RESET} : {name:<48} {GREEN}{detail}{RESET}")
    else:
        print(f"  {RED}✖ FAIL{RESET} : {name:<48} {RED}{detail}{RESET}")


print(f"\n{CYAN}======================================================================{RESET}")
print(f"{CYAN}           PY AGENT ALL-IN-ONE DIAGNOSTIC & SANITY SUITE              {RESET}")
print(f"{CYAN}======================================================================{RESET}\n")

all_passed = True

# --- PASS 1: GRANULAR BYTECODE COMPILATION (22 FILES) ---
print(f"{CYAN}[Pass 1/8] Bytecode Compilation (Granular 22 Files){RESET}")
files_to_compile = [
    "ai-agent.py",
    "modules/agent_core.py",
    "modules/agent_ipython.py",
    "modules/agent_tools.py",
    "modules/agent_tui.py",
    "modules/agent_tui_async.py",
    "modules/agent_usage.py",
    "modules/agent_cloud.py",
    "modules/agent_context.py",
    "modules/agent_skills.py",
    "modules/agent_ui.py",
    "modules/agent_voice.py",
    "modules/agent_tts.py",
    "modules/model-select.py",
    "modules/speed_test.py",
    "modules/ai-agent-sessions",
    "modules/ai-agent-memories",
    "modules/chat",
    "tools/loop/ralph.py",
    "plugins/webui/server.py",
    "plugins/pycode/bridge.py",
]

for f in files_to_compile:
    full_path = os.path.join(CFG_DIR, f)
    try:
        py_compile.compile(full_path, doraise=True)
        print_result(f, True)
    except Exception as e:
        print_result(f, False, str(e))
        all_passed = False

# --- PASS 2: GRANULAR MODULE IMPORTS ---
print(f"\n{CYAN}[Pass 2/8] Module Imports & Cross-Dependencies{RESET}")
modules_to_import = [
    "agent_core",
    "agent_ipython",
    "agent_tools",
    "agent_usage",
    "agent_cloud",
    "agent_context",
    "agent_skills",
    "agent_ui",
    "agent_voice",
    "agent_tts",
    "speed_test",
]

for mod in modules_to_import:
    try:
        importlib.import_module(mod)
        print_result(f"import {mod}", True)
    except Exception as e:
        print_result(f"import {mod}", False, str(e))
        all_passed = False

# --- PASS 3: DATABASE SUBCOMMAND PROBES ---
print(f"\n{CYAN}[Pass 3/8] SQLite Subsystem & Subcommand Probes{RESET}")
test_ws = "test_unified_sanity_ws"
try:
    r = subprocess.run(
        [
            sys.executable,
            os.path.join(CFG_DIR, "modules", "ai-agent-sessions"),
            "init",
            test_ws,
        ],
        capture_output=True,
        text=True,
        timeout=5,
    )
    print_result("ai-agent-sessions init", r.returncode == 0)
except Exception as e:
    print_result("ai-agent-sessions init", False, str(e))
    all_passed = False

try:
    r = subprocess.run(
        [
            sys.executable,
            os.path.join(CFG_DIR, "modules", "ai-agent-sessions"),
            "get-count",
            test_ws,
        ],
        capture_output=True,
        text=True,
        timeout=5,
    )
    print_result("ai-agent-sessions get-count", r.stdout.strip().isdigit())
except Exception as e:
    print_result("ai-agent-sessions get-count", False, str(e))
    all_passed = False

try:
    r = subprocess.run(
        [
            sys.executable,
            os.path.join(CFG_DIR, "modules", "ai-agent-memories"),
            "get-tpm-count",
            test_ws,
        ],
        capture_output=True,
        text=True,
        timeout=5,
    )
    print_result("ai-agent-memories get-tpm-count", r.stdout.strip().isdigit())
except Exception as e:
    print_result("ai-agent-memories get-tpm-count", False, str(e))
    all_passed = False

# Isolated Sandbox Workspace for Functional Tests
sandbox_dir = tempfile.mkdtemp(prefix="local_ai_test_")

try:
    # --- PASS 4: STATE ENGINE & MEMORY DEFAULTS ---
    print(f"\n{CYAN}[Pass 4/8] State Machine, Caching Engine & Defaults{RESET}")
    import agent_core as core

    core.save_state("test_key_sanity", 99999)
    st_val = core.get_state("test_key_sanity")
    p4_a = st_val == 99999
    print_result("State Save & Cached Read", p4_a, f"Read: {st_val}")

    p4_b = core.DEFAULTS.get("memory_active") is False
    print_result("Default Memory Opt-in Setting", p4_b, "memory_active=False")
    all_passed = all_passed and p4_a and p4_b

    # --- PASS 5: LIVE TOOL EXECUTION, SURGICAL EDITS & AST GUARDS ---
    print(f"\n{CYAN}[Pass 5/8] Live Tool Execution Engine, edit_file & AST Guards{RESET}")
    import agent_tools as tools

    # 1. Create file with write_file
    res_w = tools.run_tool(
        "write_file",
        {"path": "test_script.py", "content": "x = 42\nprint(x)\n"},
        sandbox_dir,
    )
    p5_a = "wrote" in res_w
    print_result("write_file (Create New File)", p5_a, res_w.strip())

    # 2. Block invalid Python syntax
    res_bad = tools.run_tool(
        "write_file",
        {"path": "broken.py", "content": "def broken_syntax(:\n    pass"},
        sandbox_dir,
    )
    p5_b = "[error] Write blocked" in res_bad
    print_result("write_file (AST Syntax Guard Block)", p5_b, "Blocked invalid syntax")

    # 3. Read file
    res_r = tools.run_tool("read_file", {"path": "test_script.py"}, sandbox_dir)
    p5_c = "x = 42" in res_r
    print_result("read_file (Inspect File)", p5_c, f"Length: {len(res_r)} chars")

    # 4. Surgical edit_file
    res_edit = tools.run_tool(
        "edit_file",
        {"path": "test_script.py", "old_str": "x = 42", "new_str": "x = 100"},
        sandbox_dir,
    )
    p5_d = "Successfully edited" in res_edit
    print_result("edit_file (Surgical String Replace)", p5_d, "x=42 -> x=100")

    # 5. Overwrite Protection Guard
    res_wipe = tools.run_tool(
        "write_file", {"path": "test_script.py", "content": "wiped"}, sandbox_dir
    )
    p5_e = "[error] File 'test_script.py' already exists" in res_wipe
    print_result(
        "write_file (Accidental Overwrite Guard)",
        p5_e,
        "Blocked overwrite without overwrite=true",
    )

    # 6. List directory
    res_l = tools.run_tool("list_dir", {"path": "."}, sandbox_dir)
    p5_f = "test_script.py" in res_l
    print_result("list_dir", p5_f, f"Entries: {res_l.splitlines()}")

    # 7. Subprocess execution
    old_gates = os.environ.get("AI_CONFIRM_GATES")
    try:
        os.environ["AI_CONFIRM_GATES"] = "0"
        res_cmd = tools.run_tool(
            "run_command", {"command": "python3 test_script.py"}, sandbox_dir
        )
    finally:
        if old_gates is not None:
            os.environ["AI_CONFIRM_GATES"] = old_gates
        else:
            os.environ.pop("AI_CONFIRM_GATES", None)

    p5_g = res_cmd.strip() == "100"
    print_result("run_command (Subprocess Execution)", p5_g, f"Output: '{res_cmd.strip()}'")
    all_passed = all_passed and (p5_a and p5_b and p5_c and p5_d and p5_e and p5_f and p5_g)

    # --- PASS 6: IPYTHON SANDBOX KERNEL & IN-KERNEL SDK ---
    print(f"\n{CYAN}[Pass 6/8] IPython Sandbox Kernel & In-Kernel SDK{RESET}")
    import agent_ipython as ipython

    ipython.run_cell("a = 150\nb = 250", sandbox_dir)
    out2 = ipython.run_cell("a + b", sandbox_dir)
    p6_a = "400" in out2
    print_result("IPython Cross-Cell State", p6_a, f"Result: {out2.strip()}")

    out_sdk = ipython.run_cell(
        "write_file('sdk.txt', 'cat')\nedit_file('sdk.txt', 'cat', 'dog')\nprint(read_file('sdk.txt'))",
        sandbox_dir,
    )
    p6_b = "dog" in out_sdk
    print_result("In-Kernel SDK (edit_file / read_file)", p6_b, "Surgical edit in kernel")
    all_passed = all_passed and p6_a and p6_b

    # --- PASS 7: SKILL PROFILES & BLUEPRINTS ---
    print(f"\n{CYAN}[Pass 7/8] Skill Profiles & Blueprint Verification{RESET}")
    profiles_dir = os.path.join(CFG_DIR, "skills", "profiles")
    expected_profiles = [
        "custom/base.md",
        "custom/base-map.md",
        "custom/base-py.md",
        "claude/pro.md",
        "claude/pro-map.md",
        "claude/py-pro.md",
        "claude/py-pro-map.md",
        "hermes/pro.md",
        "hermes/pro-map.md",
        "hermes/py-pro.md",
        "hermes/py-pro-map.md",
        "pi/pro.md",
        "pi/pro-map.md",
        "pi/py-pro.md",
        "pi/py-pro-map.md",
    ]
    p7_a = True
    for p in expected_profiles:
        full = os.path.join(profiles_dir, p)
        if not os.path.isfile(full):
            p7_a = False
            break
        with open(full, "r", encoding="utf-8") as f:
            if "edit_file" not in f.read():
                p7_a = False
                break
    print_result("Curated Skill Profiles Verified", p7_a, "15 Profiles (with edit_file)")

    import agent_context as context

    ctx_path = os.path.join(CFG_DIR, "ai-context.md")
    if os.path.exists(ctx_path):
        entries = context.load_context_entries(ctx_path)
        print_result(f"ai-context.md ({len(entries)} intent tokens)", len(entries) > 0)
        match = context.jaccard_search("get weather", ctx_path)
        p7_b = match is not None and "wttr" in match
        print_result("Intent Matching Query ('get weather' -> wttr)", p7_b)
        all_passed = all_passed and p7_a and p7_b
    else:
        print_result("ai-context.md exists", False, "File missing")
        all_passed = False

    # --- PASS 8: SPEND LEDGER & PRICING ---
    print(f"\n{CYAN}[Pass 8/8] Spend Ledger & Cost Engine{RESET}")
    import agent_usage as usage

    orig_ledger = usage.LEDGER_PATH
    try:
        usage.LEDGER_PATH = os.path.join(sandbox_dir, "test_ledger.json")
        usage.record("gemini", 1000000, 1000000, 0.0)
        line = usage.turn_line(1000000, 1000000, 4.50, 2000000, 8192)
        p8 = "$4.50" in line
        print_result("Dummy Test Spend Accounting", p8, f"Summary: {line.strip()}")
        all_passed = all_passed and p8
    finally:
        usage.LEDGER_PATH = orig_ledger

finally:
    shutil.rmtree(sandbox_dir, ignore_errors=True)
    subprocess.run(
        [
            sys.executable,
            os.path.join(CFG_DIR, "modules", "ai-agent-sessions"),
            "clear",
            test_ws,
        ],
        capture_output=True,
        timeout=5,
    )
    db_file = os.path.join(CFG_DIR, "projects", "database", f"{test_ws}.db")
    if os.path.exists(db_file):
        try:
            os.remove(db_file)
        except OSError:
            pass

print(f"\n{CYAN}======================================================================{RESET}")
if all_passed:
    print(f"{GREEN}     ✔ ALL 8 PASSES SUCCESSFUL — PY AGENT STACK IS 100% OPERATIONAL     {RESET}")
else:
    print(f"{RED}     ✖ SOME TESTS FAILED — CHECK DETAILS ABOVE                         {RESET}")
print(f"{CYAN}======================================================================{RESET}\n")

sys.exit(0 if all_passed else 1)
