def print_result(name: str, passed: bool, detail: str = ""):
    badge = f"  {GREEN}✔ PASS{RESET}" if passed else f"  {RED}✖ FAIL{RESET}"
    det_str = f" {GREEN}{detail}{RESET}" if passed else f" {RED}{detail}{RESET}"
    print(f"{badge} : {name:<48}{det_str}")


