# --- TTY Stream Acquisition ---
def _get_tty_streams():
    try:
        t_in = open("/dev/tty", "r")
    except OSError:
        t_in = sys.stdin
    try:
        t_out = open("/dev/tty", "w")
    except OSError:
        t_out = sys.stdout
    return t_in, t_out


