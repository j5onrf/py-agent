def _fallback_get_key() -> str:
    """Self-contained terminal key reader fallback."""
    if not _HAS_TERMIOS:
        return sys.stdin.read(1) if sys.stdin.isatty() else ""
    fd = None
    close_file = False
    if not sys.stdin.isatty():
        try:
            f = open("/dev/tty", "r")
            fd = f.fileno()
            close_file = True
        except Exception:
            return ""
    else:
        fd = sys.stdin.fileno()

    old = termios.tcgetattr(fd)
    try:
        tty.setraw(fd)
        termios.tcflush(fd, termios.TCIFLUSH)
        char_bytes = os.read(fd, 1)
        if not char_bytes:
            return ""
        if char_bytes == b"\x03":
            raise KeyboardInterrupt
        if char_bytes == b"\x1b" and select.select([fd], [], [], 0.05)[0]:
            char_bytes += os.read(fd, 2)
        return char_bytes.decode("utf-8", errors="ignore")
    finally:
        termios.tcsetattr(fd, termios.TCSAFLUSH, old)
        if close_file and f:
            try:
                f.close()
            except Exception:
                pass


def get_key() -> str:
    if HAS_UI and hasattr(ui, "get_key"):
        return ui.get_key()
    return _fallback_get_key()


