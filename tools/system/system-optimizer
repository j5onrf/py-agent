#!/usr/bin/env bash
# sysop - Dynamic Optimization & Hardware Profile Integrator

set -euo pipefail
export LC_ALL=C

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/py-agent"
[[ -d "$CONFIG_DIR" ]] || CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/local-ai"

MYSYS_FILE="${CONFIG_DIR}/skills/system/mysys.md"
SYSOP_FILE="${CONFIG_DIR}/skills/system/system-optimizer.md"

printf "# SYSTEM AUTOMATION & OPTIMIZATION PROFILE\n\n"

# 1. Safely Fenced Context Data
if [[ -f "$MYSYS_FILE" ]]; then
    printf "> [Host Spec Data]:\n\`\`\`markdown\n"
    head -c 32768 "$MYSYS_FILE"
    printf "\n\`\`\`\n\n---\n\n"
fi

if [[ -f "$SYSOP_FILE" ]]; then
    printf "> [Optimizer Directives]:\n\`\`\`markdown\n"
    head -c 32768 "$SYSOP_FILE"
    printf "\n\`\`\`\n\n---\n\n"
fi

printf "## REAL-TIME KERNEL & HARDWARE TUNING TELEMETRY\n\n"

# 1. CPU Scaling & Power Profiles (Aggregated across active CPUs)
CPU_DRIVER=$(sort -u /sys/devices/system/cpu/cpu*/cpufreq/scaling_driver 2>/dev/null | paste -sd',' - || true)
CPU_GOV=$(sort -u /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor 2>/dev/null | paste -sd',' - || true)
CPU_EPP=$(sort -u /sys/devices/system/cpu/cpu*/cpufreq/energy_performance_preference 2>/dev/null | paste -sd',' - || true)

: "${CPU_DRIVER:=generic/unknown}" "${CPU_GOV:=unknown}" "${CPU_EPP:=N/A}"

printf "### 1. CPU Scaling & Power Profiles\n"
printf "* CPU Scaling Driver: \`%s\`\n" "$CPU_DRIVER"
printf "* Active Governor: \`%s\`\n" "$CPU_GOV"
printf "* Energy Performance Preference (EPP): \`%s\`\n\n" "$CPU_EPP"

# 2. Virtual Memory & Pressure (PSI)
SWAPPINESS=$(cat /proc/sys/vm/swappiness 2>/dev/null || echo "unknown")
VFS_CACHE=$(cat /proc/sys/vm/vfs_cache_pressure 2>/dev/null || echo "unknown")
DIRTY_RATIO=$(cat /proc/sys/vm/dirty_ratio 2>/dev/null || echo "unknown")
DIRTY_BG_RATIO=$(cat /proc/sys/vm/dirty_background_ratio 2>/dev/null || echo "unknown")

THP_STATE="unknown"
if [[ -f "/sys/kernel/mm/transparent_hugepage/enabled" ]]; then
    THP_STATE=$(grep -o "\[.*\]" /sys/kernel/mm/transparent_hugepage/enabled 2>/dev/null | tr -d '[]' || echo "unknown")
fi

printf "### 2. Memory Subsystem & Virtual Memory Tuning\n"
printf "* \`vm.swappiness\`: \`%s\`\n" "$SWAPPINESS"
printf "* \`vm.vfs_cache_pressure\`: \`%s\`\n" "$VFS_CACHE"
printf "* Dirty Ratio (Sync/Background): \`%s%% / %s%%\`\n" "$DIRTY_RATIO" "$DIRTY_BG_RATIO"
printf "* Transparent Huge Pages (THP): \`%s\`\n" "$THP_STATE"

if [[ -f "/proc/pressure/memory" ]]; then
    PSI_MEM=$(head -n 2 /proc/pressure/memory 2>/dev/null || true)
    if [[ -n "$PSI_MEM" ]]; then
        printf "* Memory Pressure (PSI): \`%s\`\n" "${PSI_MEM//$'\n'/ | }"
    fi
fi
printf "\n"

# 3. Storage I/O Schedulers
printf "### 3. Storage I/O Schedulers\n"
FOUND_DISKS=0
for queue in /sys/block/*/queue/scheduler; do
    if [[ -f "$queue" ]]; then
        dev_name=$(basename "$(dirname "$(dirname "$queue")")")
        if [[ ! "$dev_name" =~ ^(loop|zram|ram) ]]; then
            raw_sched=$(cat "$queue" 2>/dev/null || echo "")
            active_sched=$(grep -o "\[[^]]*\]" <<< "$raw_sched" 2>/dev/null | tr -d '[]' || true)
            [[ -z "$active_sched" ]] && active_sched="${raw_sched:-unknown}"
            printf "* Drive \`/dev/%s\`: \`%s\`\n" "$dev_name" "$active_sched"
            FOUND_DISKS=1
        fi
    fi
done
if (( FOUND_DISKS == 0 )); then
    printf "* No standard physical block devices identified.\n"
fi
printf "\n"

# 4. Network Stack Congestion
TCP_CC=$(cat /proc/sys/net/ipv4/tcp_congestion_control 2>/dev/null || echo "unknown")
DEFAULT_QDISC=$(cat /proc/sys/net/core/default_qdisc 2>/dev/null || echo "unknown")
TCP_FASTOPEN=$(cat /proc/sys/net/ipv4/tcp_fastopen 2>/dev/null || echo "unknown")

printf "### 4. Network Queueing & Congestion Control\n"
printf "* TCP Congestion Control: \`%s\`\n" "$TCP_CC"
printf "* Network Qdisc: \`%s\`\n" "$DEFAULT_QDISC"
printf "* TCP Fast Open Flag: \`%s\`\n\n" "$TCP_FASTOPEN"

# 5. Active Tuning Daemons
printf "### 5. Latency & Scheduling Daemons\n"
FOUND_DAEMONS=0
for daemon in ananicy-cpp system76-scheduler irqbalance gamemoded bpftune uksmd; do
    if systemctl is-active "$daemon" >/dev/null 2>&1; then
        printf "* \`%s.service\`: **ACTIVE**\n" "$daemon"
        FOUND_DAEMONS=1
    fi
done

if [[ -f "/sys/kernel/sched_ext/state" ]]; then
    SCX_STATE=$(cat /sys/kernel/sched_ext/state 2>/dev/null || echo "inactive")
    printf "* \`sched_ext (scx)\`: Framework present (State: \`%s\`)\n" "$SCX_STATE"
    FOUND_DAEMONS=1
fi

if (( FOUND_DAEMONS == 0 )); then
    printf "* No latency/scheduling tuning daemons detected.\n"
fi
printf "\n"

# 6. Heuristic Recommendations
printf "### 6. Heuristic Tuning Recommendations\n"
OPPORTUNITIES=()

if [[ "$TCP_CC" != "unknown" && "$TCP_CC" != bbr* ]]; then
    OPPORTUNITIES+=("* Network: TCP congestion control is set to \`$TCP_CC\`. Upgrading to \`bbr\` with \`fq\` improves throughput and reduces bufferbloat.")
fi

if grep -q "zram" /proc/swaps 2>/dev/null; then
    if [[ "$SWAPPINESS" =~ ^[0-9]+$ ]] && (( SWAPPINESS < 100 )); then
        OPPORTUNITIES+=("* Memory: ZRAM swap is active, but \`vm.swappiness\` is set to \`$SWAPPINESS\`. ZRAM performs optimally with swappiness between \`100\` and \`180\`.")
    fi
fi

if [[ "$THP_STATE" == "never" ]]; then
    OPPORTUNITIES+=("* Memory: Transparent Huge Pages (THP) is \`never\`. Setting to \`madvise\` allows high-performance workloads to opt in to 2MB pages.")
fi

if [[ "$CPU_GOV" == *"powersave"* && "$CPU_EPP" == *"power"* ]]; then
    OPPORTUNITIES+=("* CPU: Both scaling governor and EPP are configured for maximum power saving, which may increase frame latency.")
fi

if (( ${#OPPORTUNITIES[@]} > 0 )); then
    for opp in "${OPPORTUNITIES[@]}"; do
        printf "%s\n" "$opp"
    done
else
    printf "* System is well-tuned! Core scheduler, memory, and network stack settings align with high-performance profiles.\n"
fi
printf "\n"
