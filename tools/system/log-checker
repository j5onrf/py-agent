#!/usr/bin/env bash
# AI Log Triage & Diagnostics (Zero-Config / High-Precision)

set -euo pipefail
export LC_ALL=C

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/py-agent"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/py-agent"
CURSOR_FILE="${CACHE_DIR}/log-checker.cursor"
LOCK_FILE="${CACHE_DIR}/log-checker.lock"

MYSYS_FILE="${CONFIG_DIR}/skills/system/mysys.md"
[[ -f "$MYSYS_FILE" ]] || MYSYS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/local-ai/skills/system/mysys.md"

if ! mkdir -p "$CACHE_DIR" 2>/dev/null; then
    CURSOR_FILE="/dev/null"
fi

MODE="incremental"
while [[ $# -gt 0 ]]; do
    case "$1" in
        --all|-a)
            MODE="all"
            shift
            ;;
        --kernel|-k)
            MODE="kernel"
            shift
            ;;
        --reset|-r)
            rm -f "$CURSOR_FILE"
            echo ":: Cursor reset. Next run will inspect the last 30 minutes."
            exit 0
            ;;
        --help|-h)
            echo "Usage: log-checker [--all|-a] [--kernel|-k] [--reset|-r]"
            echo "  --all     Inspect full current boot (warnings & errors, newest 100)"
            echo "  --kernel  Show high-priority kernel and driver messages only"
            echo "  --reset   Reset cursor bookmark"
            exit 0
            ;;
        *)
            echo "Error: Unrecognized option '$1'. Use --help for usage." >&2
            exit 1
            ;;
    esac
done

# Early Privilege Pre-Flight
JOURNAL_READABLE=1
if command -v journalctl >/dev/null 2>&1; then
    if ! journalctl -b 0 -n 1 >/dev/null 2>&1; then
        JOURNAL_READABLE=0
    fi
fi

printf "# ACTIVE SYSTEM DIAGNOSTICS & LOG TRIAGE\n\n"
printf "> **Directives for AI:**\n"
printf "> 1. Analyze high-severity events first: failed units, kernel panics, and coredumps.\n"
printf "> 2. Filter desktop background noise (GTK warnings, portal inhibitions).\n"
printf "> 3. Identify root cause in 2 sentences max, followed by exact terminal recovery actions.\n\n---\n\n"

if (( JOURNAL_READABLE == 0 )); then
    user_name="${USER:-$(id -un)}"
    printf "## ⚠️ PRIVILEGE RESTRICTION NOTICE\n"
    printf "User is not authorized to read full system-level journal logs.\n"
    printf "To view full logs, add user to journal group: \`sudo usermod -aG systemd-journal %s\` (requires re-login).\n\n---\n\n" "$user_name"
fi

# SECTION 1: SYSTEMD FAILED UNITS
if command -v systemctl >/dev/null 2>&1; then
    sys_failed=$(systemctl --failed --no-legend --no-pager 2>/dev/null) || sys_failed=""
    usr_failed=$(systemctl --user --failed --no-legend --no-pager 2>/dev/null) || usr_failed=""

    if [[ -n "$sys_failed" || -n "$usr_failed" ]]; then
        printf "## FAILED SYSTEMD SERVICES\n\`\`\`text\n"
        [[ -n "$sys_failed" ]] && printf "[System Units]:\n%s\n" "$sys_failed"
        [[ -n "$usr_failed" ]] && printf "[User Units]:\n%s\n" "$usr_failed"
        printf "\`\`\`\n\n---\n\n"
    fi
fi

# SECTION 2: RECENT COREDUMPS (Last 24 Hours)
if command -v coredumpctl >/dev/null 2>&1; then
    recent_dumps=$(coredumpctl list --since "-24 hours" --no-legend --no-pager -n 5 2>/dev/null) || recent_dumps=""
    if [[ -n "$recent_dumps" ]]; then
        printf "## RECENT PROCESS CRASHES & COREDUMPS (Last 24h)\n\`\`\`text\n%s\n\`\`\`\n\n---\n\n" "$recent_dumps"
    fi
fi

# SECTION 3: KERNEL & DRIVER ERRORS
if command -v journalctl >/dev/null 2>&1 && (( JOURNAL_READABLE == 1 )); then
    kerrors=$(journalctl -k -b 0 -p err..emerg --no-pager -n 30 2>/dev/null) || kerrors=""
    if [[ -n "$kerrors" ]]; then
        printf "## KERNEL & DRIVER ALERTS (Ring 0 / GPU / Hardware)\n\`\`\`text\n%s\n\`\`\`\n\n---\n\n" "$kerrors"
    fi
fi

# SECTION 4: DYNAMIC SYSTEM EVENTS
if command -v journalctl >/dev/null 2>&1; then
    if [[ "$MODE" == "kernel" ]]; then
        printf "## KERNEL EVENTS (Current Boot - Last 50)\n\`\`\`text\n"
        journalctl -k -b 0 -n 50 --no-pager 2>/dev/null || printf "[No kernel logs accessible]\n"
        printf "\`\`\`\n"
    elif [[ "$MODE" == "all" ]]; then
        printf "## CURRENT BOOT (Errors & Warnings - Newest 100)\n\`\`\`text\n"
        journalctl -b 0 -p warning..emerg -n 100 --no-pager 2>/dev/null || printf "[Logs inaccessible]\n"
        printf "\`\`\`\n"
    else
        # Incremental Cursor Execution with Flock Synchronization
        exec 9>>"$LOCK_FILE"
        flock -x 9 2>/dev/null || true

        rc=0
        if [[ ! -f "$CURSOR_FILE" || ! -s "$CURSOR_FILE" ]]; then
            new_logs=$(journalctl -b 0 -p warning..emerg --since "30 minutes ago" --cursor-file="$CURSOR_FILE" -n 80 2>/dev/null) || rc=$?
        else
            new_logs=$(journalctl -b 0 -p warning..emerg --cursor-file="$CURSOR_FILE" -n 80 2>/dev/null) || rc=$?
        fi

        [[ "$new_logs" =~ ^[[:space:]]*--[[:space:]]No[[:space:]]entries[[:space:]]--[[:space:]]*$ ]] && new_logs=""

        if (( rc != 0 )); then
            printf "## DIAGNOSTIC NOTE\n*Unable to read journal events (exit code %d).*\n" "$rc"
        elif [[ -n "$new_logs" ]]; then
            printf "## NEW SYSTEM EVENTS\n\`\`\`text\n%s\n\`\`\`\n" "$new_logs"
        else
            printf "## NO NEW EVENTS RECORDED (System is Quiet)\n"
            printf "No new system errors or warnings recorded since the last check.\n\n"
            printf "### LAST RECORDED CONTEXT (Tail 5)\n\`\`\`text\n"
            journalctl -b 0 -n 5 --no-pager 2>/dev/null || printf "[Logs quiet]\n"
            printf "\`\`\`\n"
        fi

        flock -u 9 2>/dev/null || true
    fi
fi

printf "\n---\n\n"

# SECTION 5: SYSTEM PROFILE INJECTION (Safely Fenced as Untrusted Data)
if [[ -f "$MYSYS_FILE" ]]; then
    printf "## SYSTEM ARCHITECTURE PROFILE (HOST SPEC)\n\`\`\`markdown\n"
    head -c 16384 "$MYSYS_FILE"
    printf "\n\`\`\`\n"
fi
