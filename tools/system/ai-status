#!/usr/bin/env bash
# ai-status - Diagnostics for Py-Agent Cloud Models & Quotas

set -euo pipefail
export LC_ALL=C

ENV_PATH="$HOME/.config/py-agent/.env"
LOG_FILE="$HOME/.config/py-agent/.request_log"

get_gemini_limits() {
    local model="${1:-gemini-3.8-flash}"
    local m_low; m_low=$(echo "$model" | tr '[:upper:]' '[:lower:]')
    
    if [[ "$m_low" == *"3.5-flash-lite"* || "$m_low" == *"3.1-flash-lite"* ]]; then
        echo "15 RPM / 1,000 RPD (Free Tier)"
    elif [[ "$m_low" == *"2.5-flash-lite"* || "$m_low" == *"2.0-flash-lite"* ]]; then
        echo "30 RPM / 1,500 RPD (Free Tier)"
    elif [[ "$m_low" == *"3.8-flash"* ]]; then
        echo "5 RPM / 20 RPD (Free Tier)"
    elif [[ "$m_low" == *"3.7-flash"* || "$m_low" == *"3.6-flash"* || "$m_low" == *"3.5-flash"* ]]; then
        echo "5 RPM / 25 RPD (Free Tier)"
    elif [[ "$m_low" == *"-pro"* ]]; then
        echo "5 RPM / 25 RPD (Free Tier)"
    elif [[ "$m_low" == *"2.5-flash"* || "$m_low" == *"2.0-flash"* || "$m_low" == *"1.5-flash"* ]]; then
        echo "10 RPM / 250 RPD (Free Tier)"
    else
        echo "5 RPM / 25 RPD (Free Tier)"
    fi
}

check_conn() {
    local key="${1:-}" endpoint="${2:-}"
    [[ -z "$key" || -z "$endpoint" ]] && { echo 1; return; }
    local host_url
    host_url=$(grep -o -E '^https?://[^/]+' <<< "$endpoint" || echo "$endpoint")
    curl -s -I --connect-timeout 2.0 --max-time 5.0 "$host_url" >/dev/null 2>&1 && echo 0 || echo 1
}

# Static key-value parser (replaces dangerous source "$ENV_PATH")
declare -A ENV_VARS=()
if [[ -f "$ENV_PATH" ]]; then
    while IFS='=' read -r key val || [[ -n "$key" ]]; do
        key=$(echo "$key" | tr -d '[:space:]')
        [[ -z "$key" || "$key" == "#"* ]] && continue
        val=$(echo "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^["'"'"']//' -e 's/["'"'"']$//')
        ENV_VARS["$key"]="$val"
    done < "$ENV_PATH"
fi

active_providers=()
active_keys=()
active_models=()
active_urls=()

for k_name in "${!ENV_VARS[@]}"; do
    if [[ "$k_name" =~ ^([A-Z0-9_]+_API_KEY|[A-Z0-9_]+_KEY)$ ]]; then
        k_val="${ENV_VARS[$k_name]}"
        if [[ -n "$k_val" && "$k_val" != *"your"* && "$k_val" != *"here"* && "$k_val" != *"api-key"* ]]; then
            prefix=$(sed -E 's/_(API_)?KEY$//' <<< "$k_name")
            provider=$(echo "$prefix" | tr '[:upper:]' '[:lower:]')
            m_val="${ENV_VARS[${prefix}_MODEL]:-}"
            u_val="${ENV_VARS[${prefix}_URL]:-}"

            if [[ "$provider" == "openrouter" ]]; then
                m_val="${m_val:-openrouter/free}"
                u_val="https://openrouter.ai/api/v1/chat/completions"
            elif [[ "$provider" == "gemini" ]]; then
                m_val="${m_val:-gemini-3.8-flash}"
                u_val="https://generativelanguage.googleapis.com"
            elif [[ "$provider" == "custom2" ]]; then
                m_val="${m_val:-deepseek-chat}"
                u_val="${u_val:-https://api.deepseek.com/chat/completions}"
            elif [[ "$provider" == "custom" ]]; then
                m_val="${m_val:-Qwen/Qwen3.8-27B}"
                u_val="${u_val:-https://router.huggingface.co/v1/chat/completions}"
            else
                m_val="${m_val:-default-model}"
                u_val="${u_val:-https://api.openai.com/v1/chat/completions}"
            fi

            if [[ ! " ${active_providers[*]:-} " =~ " ${provider} " ]]; then
                active_providers+=("$provider")
                active_keys+=("$k_val")
                active_models+=("$m_val")
                active_urls+=("$u_val")
            fi
        fi
    fi
done

request_stats="0|0|0|0"
if [[ -f "$LOG_FILE" ]]; then
    request_stats=$(python3 -c "
import os, time
log_file = os.path.expanduser('~/.config/py-agent/.request_log')
now = int(time.time())
day_ago, min_ago = now - 86400, now - 60
rpd = {'gemini': 0, 'openrouter': 0}
rpm = {'gemini': 0, 'openrouter': 0}
valid = []
try:
    with open(log_file, 'r') as f:
        for line in f:
            parts = line.strip().split('|')
            if len(parts) == 2 and parts[0].isdigit():
                ts, provider = int(parts[0]), parts[1]
                if ts >= day_ago:
                    valid.append(f'{ts}|{provider}')
                    if provider in rpd:
                        rpd[provider] += 1
                        if ts >= min_ago:
                            rpm[provider] += 1
    tmp = log_file + '.tmp'
    with open(tmp, 'w') as f:
        for entry in valid:
            f.write(f'{entry}\n')
    os.replace(tmp, log_file)
except Exception:
    pass
print(f\"{rpd['gemini']}|{rpm['gemini']}|{rpd['openrouter']}|{rpm['openrouter']}\")
" 2>/dev/null || echo "0|0|0|0")
fi

gemini_rpd=$(cut -d'|' -f1 <<< "$request_stats")
gemini_rpm=$(cut -d'|' -f2 <<< "$request_stats")
or_rpd=$(cut -d'|' -f3 <<< "$request_stats")
or_rpm=$(cut -d'|' -f4 <<< "$request_stats")

custom_status=$(check_conn "${ENV_VARS[CUSTOM_API_KEY]:-}" "${ENV_VARS[CUSTOM_URL]:-https://router.huggingface.co}")
custom2_status=$(check_conn "${ENV_VARS[CUSTOM2_API_KEY]:-}" "${ENV_VARS[CUSTOM2_URL]:-https://api.deepseek.com}")
gemini_status=$(check_conn "${ENV_VARS[GEMINI_API_KEY]:-}" "https://generativelanguage.googleapis.com")
or_status=$(check_conn "${ENV_VARS[OPENROUTER_API_KEY]:-}" "https://openrouter.ai")
local_status=$(curl -s -I --connect-timeout 1.0 --max-time 2.0 "http://127.0.0.1:8080" >/dev/null 2>&1 && echo 0 || echo 1)

local_model="Local Server"
if [[ $local_status -eq 0 ]]; then
    local_model=$(curl -s --connect-timeout 1.0 --max-time 3.0 "http://127.0.0.1:8080/v1/models" | python3 -c "
import sys, json
try:
    models = json.load(sys.stdin).get('data', [])
    if models: print(models[0].get('id', 'Local Server'))
    else: print('Local Server')
except Exception:
    print('Local Server')
" 2>/dev/null || echo "Local Server")
fi

resolved_provider="*None / All Offline*"
resolved_model="*None*"

for i in "${!active_providers[@]}"; do
    prov="${active_providers[$i]}"
    key_v="${active_keys[$i]}"
    mod_v="${active_models[$i]}"
    url_v="${active_urls[$i]}"
    
    status=$(check_conn "$key_v" "$url_v")
    if [[ $status -eq 0 ]]; then
        if [[ "$prov" == "custom" ]]; then resolved_provider="Hugging Face / Custom 1"
        elif [[ "$prov" == "custom2" ]]; then
            if [[ "$url_v" == *"deepseek"* ]]; then resolved_provider="DeepSeek Direct"
            else resolved_provider="Custom 2 Direct"
            fi
        elif [[ "$prov" == "gemini" ]]; then resolved_provider="Google Gemini"
        elif [[ "$prov" == "openrouter" ]]; then resolved_provider="OpenRouter"
        else resolved_provider=$(echo "$prov" | tr '[:lower:]' '[:upper:]')
        fi
        resolved_model="$mod_v"
        break
    fi
done

if [[ "$resolved_provider" == "*None / All Offline*" && $local_status -eq 0 ]]; then
    resolved_provider="Local AI Server"
    resolved_model="$local_model"
fi

st_label() {
    local key="$1" status="$2"
    if [[ -z "$key" ]]; then echo "Disabled (No Key)"
    elif [[ "$status" -eq 0 ]]; then echo "**Online**"
    else echo "Offline"
    fi
}

gemini_cap=$(get_gemini_limits "${ENV_VARS[GEMINI_MODEL]:-gemini-3.8-flash}")

c2_url="${ENV_VARS[CUSTOM2_URL]:-https://api.deepseek.com/chat/completions}"
c2_label="Custom 2"
if [[ "$c2_url" == *"deepseek"* ]]; then c2_label="Custom 2 (DeepSeek)"
elif [[ "$c2_url" == *"groq"* ]]; then c2_label="Custom 2 (Groq)"
elif [[ "$c2_url" == *"mistral"* ]]; then c2_label="Custom 2 (Mistral)"
fi

echo "### Cloud & Provider System Status"
echo "| Provider | Active Model | Status | Quota & Live Activity |"
echo "| :--- | :--- | :--- | :--- |"
echo "| **Active Route (${resolved_provider})** | \`${resolved_model}\` | **Online** | Priority Active |"
echo "| **Custom 1 (Local / HF)** | \`${ENV_VARS[CUSTOM_MODEL]:-Qwen/Qwen3.8-27B}\` | $(st_label "${ENV_VARS[CUSTOM_API_KEY]:-}" "$custom_status") | Router / Spaces |"
echo "| **${c2_label}** | \`${ENV_VARS[CUSTOM2_MODEL]:-deepseek-chat}\` | $(st_label "${ENV_VARS[CUSTOM2_API_KEY]:-}" "$custom2_status") | Direct Endpoint |"
echo "| **Google Gemini** | \`${ENV_VARS[GEMINI_MODEL]:-gemini-3.8-flash}\` | $(st_label "${ENV_VARS[GEMINI_API_KEY]:-}" "$gemini_status") | RPM: ${gemini_rpm} / RPD: ${gemini_rpd} • Cap: ${gemini_cap} |"
echo "| **OpenRouter** | \`${ENV_VARS[OPENROUTER_MODEL]:-openrouter/free}\` | $(st_label "${ENV_VARS[OPENROUTER_API_KEY]:-}" "$or_status") | RPM: ${or_rpm} / RPD: ${or_rpd} • Cap: 20 RPM / 50 RPD |"
echo "| **Local Server** | \`${local_model}\` | $([[ $local_status -eq 0 ]] && echo "**Online**" || echo "Offline") | Port 8080 |"
