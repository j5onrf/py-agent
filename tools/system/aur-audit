#!/usr/bin/env bash
# aur-audit - Lightweight Zero-Trust AUR Auditor [Local & Cloud Optimized]

set -euo pipefail
export LC_ALL=C

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/py-agent"
[[ -d "$CFG_DIR" ]] || CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/local-ai"
ALIAS_AI_SCRIPT="${CFG_DIR}/ai-agent.py"

printf "\033[1;36m[aur-audit]\033[0m Zero-Trust PKGBUILD Auditor (Local SLM Profile)\n\n"

PKG_NAME="${1:-}"
if [[ -z "$PKG_NAME" ]]; then
    # Temporarily disable bracketed paste mode to prevent control code leakage
    printf '\e[?2004l' >&2 2>/dev/null || true
    read -r -e -p "❯ Enter AUR package name to audit: " PKG_NAME || { echo "Cancelled." >&2; exit 1; }
    printf '\e[?2004h' >&2 2>/dev/null || true
fi

# Sanitize bracketed paste markers (\e[200~ / \e[201~), ANSI sequences, and whitespace
PKG_NAME="$(printf '%s' "$PKG_NAME" | sed -E $'s/\x1b\\[[0-9;]*[a-zA-Z~]//g' | tr -d '[:space:]' | tr -d '\000-\037\177')"
PKG_NAME="${PKG_NAME#\~}"
PKG_NAME="${PKG_NAME%\~}"

if [[ -z "$PKG_NAME" || ! "$PKG_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9_@.+-]*$ ]]; then
    printf "❌ Error: Invalid package name: '%s'\n" "$PKG_NAME" >&2
    exit 1
fi

TEMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TEMP_DIR"; }
trap cleanup EXIT INT TERM

printf "⠋ Fetching AUR repo: \033[1;33m%s\033[0m...\r" "$PKG_NAME" >&2
git clone --depth 1 "https://aur.archlinux.org/${PKG_NAME}.git" "$TEMP_DIR" >/dev/null 2>&1 || {
    printf "\r\033[2K❌ Error: Package '%s' not found on AUR.\n" "$PKG_NAME" >&2
    exit 1
}
printf "\r\033[2K" >&2

if [[ ! -f "$TEMP_DIR/PKGBUILD" ]]; then
    printf "❌ Error: PKGBUILD missing.\n" >&2
    exit 1
fi

PKGBUILD_SNIP="$(head -c 4096 "$TEMP_DIR/PKGBUILD")"
SRCINFO_SNIP=""
if [[ -f "$TEMP_DIR/.SRCINFO" ]]; then
    SRCINFO_SNIP="$(grep -E '^\s*(pkgver|url|source|depends)\s*=' "$TEMP_DIR/.SRCINFO" | head -n 12)"
fi

ANCILLARY_SCRIPTS=""
while IFS= read -r -d '' asset; do
    base="$(basename "$asset")"
    if [[ "$base" != "PKGBUILD" && "$base" != ".SRCINFO" && ! -d "$asset" ]]; then
        if [[ "$base" == *.install || "$base" == *.service || "$base" == *.sh ]]; then
            content="$(head -c 2048 "$asset")"
            ANCILLARY_SCRIPTS+=$'\n\n'"#### [Embedded Script]: \`${base}\`"$'\n\`\`\`bash\n'"${content}"$'\n\`\`\`'
        fi
    fi
done < <(find "$TEMP_DIR" -maxdepth 1 -not -name '.git' -print0)

PROMPT="Zero-Trust Arch Linux PKGBUILD Audit:
Package: $PKG_NAME

.SRCINFO:
$SRCINFO_SNIP

PKGBUILD:
\`\`\`bash
$PKGBUILD_SNIP
\`\`\`"

if [[ -n "$ANCILLARY_SCRIPTS" ]]; then
    PROMPT+=$'\n\n'"Ancillary Scripts:${ANCILLARY_SCRIPTS}"
fi

PROMPT+=$'\n\n'"Rules:
1. Verify source URLs are authentic official domains (not unverified mirrors).
2. Flag dynamic curl/wget/fetch downloads in build() or package() that bypass source=().
3. Confirm build/install stay strictly in \$srcdir and \$pkgdir.
4. Official -bin packages from upstream releases with valid checksums are PASS.

Output Format:
### 🛡️ AUR AUDIT: [ PASS | WARNING | FAIL ]
* Trust: [High / Med / Low]
* Critical Alerts: [None or exact line]
* Action: [Safe to install via yay -S <pkg> / Do not install]"

if [[ "${AI_CONTEXT_RUN:-0}" != "0" ]]; then
    printf "%s\n" "$PROMPT"
else
    printf "\033[2m[sys] Auditing '%s' via local model...\033[0m\n" "$PKG_NAME" >&2
    export AI_SHOW_THINKING=0
    export AI_THINKING_BUDGET=0
    printf "%s\n" "$PROMPT" | python3 "$ALIAS_AI_SCRIPT" --talk - --aur-audit
fi
