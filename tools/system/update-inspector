#!/usr/bin/env bash
# AI Update Inspector - Universal Arch Linux & CachyOS

set -euo pipefail
export LC_ALL=C

CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/py-agent"
[[ -d "$CFG_DIR" ]] || CFG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/local-ai"

spinner_chars=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
SPINNER_PID=""

start_spinner() {
    if [[ -t 2 && "${AI_CONTEXT_RUN:-0}" == "0" ]]; then
        printf "\033[?25l" >&2
        (
            i=0
            while true; do
                printf "\r\033[1;32m%s\033[0m Checking for updates & pending pacnew files..." "${spinner_chars[i]}" >&2
                i=$(( (i + 1) % 10 ))
                sleep 0.08
            done
        ) &
        SPINNER_PID=$!
    fi
}

stop_spinner() {
    if [[ -n "${SPINNER_PID:-}" ]]; then
        kill "$SPINNER_PID" 2>/dev/null || true
        wait "$SPINNER_PID" 2>/dev/null || true
        SPINNER_PID=""
    fi
    if [[ -t 2 && "${AI_CONTEXT_RUN:-0}" == "0" ]]; then
        printf "\r\033[2K\r\033[?25h" >&2
    fi
}

trap stop_spinner EXIT
trap 'stop_spinner; exit 130' INT
trap 'stop_spinner; exit 143' TERM

start_spinner

all_updates=""
repo_summary=""
total_native_count=0
total_aur_count=0

# 1. Native Updates
if command -v checkupdates >/dev/null 2>&1; then
    err_file=$(mktemp)
    if raw_repo=$(checkupdates 2>"$err_file"); then
        if [[ -n "$raw_repo" ]]; then
            all_updates="$raw_repo"
            total_native_count=$(awk 'NF {c++} END {print c+0}' <<< "$raw_repo")
            mapfile -t pkg_name_arr < <(awk '{print $1}' <<< "$raw_repo")
            
            repo_info=$(pacman -Si "${pkg_name_arr[@]}" 2>/dev/null | awk '/^Repository/ {repo=$3} /^Name/ {name=$3; if (!seen[name]) { print repo"|"name; seen[name]=1 } }' || true)
            repos=$(cut -d'|' -f1 <<< "$repo_info" | sort -u)
            for r in $repos; do
                [[ -z "$r" ]] && continue
                count=$(grep -c "^${r}|" <<< "$repo_info" || true)
                pkgs=$(grep "^${r}|" <<< "$repo_info" | cut -d'|' -f2 | awk '{printf "%s`%s`", (NR==1?"":", "), $1} END {print ""}')
                repo_summary+="* **Repository \`$r\`**: \`$count\` packages"$'\n'"  - Packages: $pkgs"$'\n\n'
            done
        else
            repo_summary="* **Native Repositories**: \`0\` updates (System up to date)"$'\n\n'
        fi
    else
        err_msg=$(head -n 2 "$err_file" 2>/dev/null | tr '\n' ' ' || true)
        repo_summary="* **Native Repositories**: *checkupdates status error* (${err_msg:-Database lock or network issue})"$'\n\n'
    fi
    rm -f "$err_file"
else
    repo_summary="* **Native Repositories**: *checkupdates utility not found*"$'\n\n'
fi

# 2. AUR Updates
aur_helper=""
if command -v paru >/dev/null 2>&1; then
    aur_helper="paru"
elif command -v yay >/dev/null 2>&1; then
    aur_helper="yay"
fi

aur_summary=""
if [[ -n "$aur_helper" ]]; then
    err_file=$(mktemp)
    if raw_aur=$($aur_helper -Qua 2>"$err_file"); then
        if [[ -n "$raw_aur" ]]; then
            all_updates+=$'\n'"$raw_aur"
            total_aur_count=$(awk 'NF {c++} END {print c+0}' <<< "$raw_aur")
            aur_pkgs=$(awk '{printf "%s`%s`", (NR==1?"":", "), $1} END {print ""}' <<< "$raw_aur")
            aur_summary="* **AUR ($aur_helper)**: \`$total_aur_count\` packages"$'\n'"  - Packages: $aur_pkgs"$'\n'
        else
            aur_summary="* **AUR ($aur_helper)**: \`0\` updates"$'\n'
        fi
    else
        err_msg=$(head -n 2 "$err_file" 2>/dev/null | tr '\n' ' ' || true)
        aur_summary="* **AUR ($aur_helper)**: *query error* (${err_msg:-Network or helper failure})"$'\n'
    fi
    rm -f "$err_file"
else
    aur_summary="* **AUR**: *No AUR helper (paru/yay) detected*"$'\n'
fi

# 3. Pacnew Files (Inspect entire /etc hierarchy without depth limit)
pacnew_list=()
while IFS= read -r -d '' pfile; do
    pacnew_list+=("$pfile")
done < <(find /etc -name "*.pacnew" -print0 2>/dev/null || true)

# 4. Anchored Reboot Triggers
reboot_triggers=()
pkg_first_words=$(awk '{print $1}' <<< "$all_updates")

if grep -iE '^(linux|linux-cachyos|linux-lts|linux-zen|intel-ucode|amd-ucode)$' <<< "$pkg_first_words" >/dev/null 2>&1; then
    reboot_triggers+=("Kernel / Microcode update")
fi
if grep -iE '^(systemd|systemd-libs)$' <<< "$pkg_first_words" >/dev/null 2>&1; then
    reboot_triggers+=("systemd core libraries")
fi
if grep -iE '^glibc$' <<< "$pkg_first_words" >/dev/null 2>&1; then
    reboot_triggers+=("glibc core C library")
fi
if grep -iE '^(nvidia|nvidia-utils|nvidia-dkms)$' <<< "$pkg_first_words" >/dev/null 2>&1; then
    reboot_triggers+=("Nvidia proprietary graphics driver")
fi

# 5. Keyring Alert (Recommends safe full update)
keyring_alert=""
if grep -iE '^(archlinux-keyring|cachyos-keyring)$' <<< "$pkg_first_words" >/dev/null 2>&1; then
    matched_keyrings=$(grep -iE '^(archlinux-keyring|cachyos-keyring)$' <<< "$pkg_first_words" | tr '\n' ' ')
    keyring_alert="⚠️ **KEYRING PRIORITY**: Update keyrings first: \`sudo pacman -Syu ${matched_keyrings}\`"
fi

# 6. Spotlight Apps
SPOTLIGHT_REGEX="^(brave|firefox|chromium|zen-browser|librewolf|google-chrome|zed|neovim|code|vscodium|emacs|helix|yt-dlp|linux|linux-lts|linux-zen|linux-cachyos|nvidia|mesa|vulkan-intel|pipewire|wireplumber|hyprland|waybar|sway|plasma|gnome|systemd|glibc|archlinux-keyring|cachyos-keyring|python|rust|docker|kitty|ghostty)"
spotlight_raw=""
if [[ -n "$all_updates" ]]; then
    spotlight_raw=$(grep -iE "$SPOTLIGHT_REGEX" <<< "$all_updates" || true)
fi

stop_spinner

# 7. Output Format (AI Context vs. Clean Terminal View)
if [[ "${AI_CONTEXT_RUN:-0}" != "0" ]]; then
    SKILL_FILE="$CFG_DIR/skills/system/update-inspector.md"
    if [[ -f "$SKILL_FILE" ]]; then
        printf "> [Context Directives]:\n\`\`\`markdown\n"
        head -c 16384 "$SKILL_FILE"
        printf "\n\`\`\`\n\n---\n\n"
    fi
    printf "## REAL-TIME UPDATE TELEMETRY\n"
else
    printf "# ARCH LINUX & CACHYOS UPDATE INSPECTOR\n\n"
fi

printf "* Total Pending Updates: \`%d\` (Native: \`%d\`, AUR: \`%d\`)\n" \
    "$((total_native_count + total_aur_count))" "$total_native_count" "$total_aur_count"

if (( ${#reboot_triggers[@]} > 0 )); then
    reboot_str=$(IFS=", "; echo "${reboot_triggers[*]}")
    printf "* Reboot Required: **YES** (%s)\n" "$reboot_str"
else
    printf "* Reboot Required: **NO** (Only user-space updates pending)\n"
fi

if [[ -n "$keyring_alert" ]]; then
    printf "* %s\n" "$keyring_alert"
fi
printf "\n"

if (( ${#pacnew_list[@]} > 0 )); then
    printf "### PENDING CONFIGURATION MERGES (.pacnew)\n"
    printf "⚠️ Unmerged \`.pacnew\` files found in \`/etc\`. Run \`sudo pacdiff\` to inspect:\n"
    for pf in "${pacnew_list[@]}"; do
        printf "* \`%s\`\n" "$pf"
    done
    printf "\n"
else
    printf "### PENDING CONFIGURATION MERGES (.pacnew)\n* None detected. All \`/etc\` configurations are up to date.\n\n"
fi

if [[ -n "$spotlight_raw" ]]; then
    printf "### KEY / SPOTLIGHT APPLICATION UPDATES\n"
    while IFS= read -r line; do
        [[ -z "$line" ]] && continue
        pkg=$(awk '{print $1}' <<< "$line")
        old_v=$(awk '{print $2}' <<< "$line")
        new_v=$(awk '{print $4}' <<< "$line")
        printf "* **\`%s\`**: \`%s\` ──► \`%s\`\n" "$pkg" "$old_v" "$new_v"
    done <<< "$spotlight_raw"
    printf "\n"
fi

printf "### REPOSITORY BREAKDOWN\n"
printf '%b' "$repo_summary"
printf '%b' "$aur_summary"
