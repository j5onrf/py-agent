# ==============================================================================
# Py-Agent Environment Configuration (~/.config/py-agent/.env)
#
# RULES:
# 1. Top-Down: First uncommented key is active for CLI sessions.
# 2. Toggle: Add '#' to disable; remove '#' to enable.
# 3. Add More: Define CUSTOM3_*, CUSTOM4_*, etc. anywhere.
# 4. Fallback: If all keys have '#', routes to local server (:8080).
# 5. TUI Config: Run 'model select' to configure everything interactively.
# ==============================================================================

# ── 1. Custom 1 / Hugging Face Router ─────────────────────────────────────────
# CUSTOM_API_KEY="hugging-face-api-key"
CUSTOM_URL="https://router.huggingface.co/v1/chat/completions"
CUSTOM_MODEL="Qwen/Qwen3.8-27B"

# ── 2. Custom 2 / Generic Endpoint (DeepSeek, OpenAI, TokenHarbor, etc.) ──────
# CUSTOM2_API_KEY="sk-your-key-here"
CUSTOM2_URL="https://tokenharbor.ai/v1/chat/completions"
CUSTOM2_MODEL="qwen3.8-flash:free"

# ── 3. Custom 3 / Openbot Planner Slot (Google Gemini 3.8 Flash) ──────────────────────
# CUSTOM3_API_KEY="AIzaSyYourGeminiApiKeyHere"
# CUSTOM3_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
# CUSTOM3_MODEL="gemini-3.8-flash"

# ── 4. Custom 4 / Openbot Worker Slot (Google Gemini 3.5 Flash Lite) ──────────────────
# CUSTOM4_API_KEY="AIzaSyYourGeminiApiKeyHere"
# CUSTOM4_URL="https://generativelanguage.googleapis.com/v1beta/openai/chat/completions"
# CUSTOM4_MODEL="gemini-3.5-flash-lite"

# ── 5. Custom 5 / PyRouter OpenCode (Port 20128) [Commented Out] ──────────────
# CUSTOM5_API_KEY="not-needed"
# CUSTOM5_URL="http://127.0.0.1:20128/v1/chat/completions"
# CUSTOM5_MODEL="big-pickle"

# ── Direct Gateways (Alternative Toggles) ─────────────────────────────────────

# OpenRouter Universal Gateway
# OPENROUTER_API_KEY="sk-or-v1-YourOpenRouterKeyHere"
# OPENROUTER_MODEL="openrouter/free"

# Native Gemini Direct
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
# GEMINI_MODEL="gemini-3.5-flash-lite"

# ── Auxiliary Services ────────────────────────────────────────────────────────

# Google Search Grounding (/gnd)
# GND_KEY="AIzaSyYourGeminiApiKeyHere"
# GND_MODEL="gemini-2.5-flash"

# Voice Bridge Transcription (:9999)
# GEM_VOICE="AIzaSyYourGeminiApiKeyHere"
# GEM_MODEL="gemini-3.5-flash-lite"

# Multimodal Vision OCR
# IMG_VOICE="AIzaSyYourGeminiApiKeyHere"
# IMG_MODEL="gemini-3.5-flash-lite"

# ── Context Window & Execution Limits ─────────────────────────────────────────
AI_MAX_TOKENS="8192"
AI_MAX_AGENT_ROUNDS="10"
